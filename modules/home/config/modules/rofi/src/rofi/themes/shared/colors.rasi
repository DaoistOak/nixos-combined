
/* Import color-scheme from the `colors` directory.
 * `theme-switcher.rasi` is generated by scripts/theme (gen_rofi_colors) from the
 * shared theme DB, so every rofi theme follows the active selection. It is
 * written into the MANAGED ~/.config/rofi/colors/ tree — the old
 * ~/.config/hypr/rofi/colors/ path was an unmanaged leftover that happened to
 * exist. `catppuccin-macchiato-auto.rasi` is the static fallback if the
 * runtime file has not been generated yet. */

/* rofi applies later @imports last, so the static Catppuccin file provides
 * defaults and the generated file overrides every key it defines. */
@import "colors/catppuccin-macchiato-auto.rasi"
@import "colors/theme-switcher.rasi"
