#!/bin/bash
# Shell-only bits of the zsh config. Everything portable lives in
# modules/home/config/modules/zsh/default.nix (history, env, aliases,
# functions, completion styles) — this file keeps only ORDER-SENSITIVE
# startup: zvm must load before powerlevel10k, fzf/atuin bindings last.

# Enable Powerlevel10k instant prompt (experimental, keep commented)
#if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
#  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
#fi

# home-manager session vars (PATH, etc.)
source ~/.nix-profile/etc/profile.d/hm-session-vars.sh

# Filename completion also offers dotfiles (e.g. `cd .<Tab>`). Must run AFTER
# compinit: compinit resets _comp_options, and home-manager's enableCompletion
# calls it earlier in this startup (order 500 vs this file's 1000).
_comp_options+=(globdots)

# Load private API keys from the untracked secrets file (zsh syntax) if present.
[[ -f "$HOME/.config/nixos/secrets/secrets.zsh" ]] && source "$HOME/.config/nixos/secrets/secrets.zsh"

# vi-mode: zsh-vi-mode (zvm plugin) replaces the manual bindkey -v + cursor
# block. Keep BEFORE powerlevel10k is sourced: p10k reads the keymap for its
# vi_mode segment. zvm handles vi editing, cursor shapes and text objects.
# The package is symlinked into ${ZDOTDIR}/zsh-vi-mode by
# modules/home/config/modules/zsh/default.nix (like powerlevel10k).
zvm_config() {
  ZVM_READKEY_ENGINE=zle     # zle engine (NEX is still beta)
  # Init at source time. The default (deferred) mode runs zvm_init at the
  # FIRST precmd, i.e. after this whole file, so zvm's bindings (Ctrl-R,
  # etc.) would clobber the fzf/atuin bindings below — the old workaround
  # re-ran `atuin init` via zvm_after_init_commands, which instead
  # initialized atuin twice (duplicated ZSH_AUTOSUGGEST_STRATEGY + a second
  # background search-index job per shell).
  ZVM_INIT_MODE=sourcing
  ZVM_KEYTIMEOUT=0.4                  # -> KEYTIMEOUT=40, i.e. 0.4s Esc window
  ZVM_LINE_INIT_MODE=$ZVM_MODE_INSERT # start each new line in insert mode
}
source ${ZDOTDIR:-$HOME/.config/zsh}/zsh-vi-mode/share/zsh-vi-mode/zsh-vi-mode.plugin.zsh

# Powerlevel10k theme (tracked via the powerlevel10k fetch source)
source ${ZDOTDIR:-$HOME/.config/zsh}/powerlevel10k/powerlevel10k.zsh-theme
# Source custom Powerlevel10k configuration
[[ ! -f ${ZDOTDIR:-~}/.p10k.zsh ]] || source ${ZDOTDIR:-~}/.p10k.zsh
POWERLEVEL9K_MODE='nerdfont-complete'
POWERLEVEL9K_PROMPT_ADD_NEWLINE=true

# FZF keybindings moved to Alt+ (frees Ctrl-T/Ctrl-R), plus Alt+F file search.
# home-manager's fzf module already ran `fzf --zsh` above (initContent order
# 910 < 1000), so its widgets exist here.
if [[ $options[zle] = on ]]; then
  # Unbind fzf's default Ctrl-T/Ctrl-R. Ctrl-R is reclaimed by atuin below,
  # Ctrl-T stays free (Alt+T is its replacement).
  for km in emacs vicmd viins; do
    bindkey -M "$km" -r '^T'
    bindkey -M "$km" -r '^R'
  done

  # Alt+T files (files+dirs), Alt+R history. Alt+C (cd) is already bound by fzf.
  for km in emacs vicmd viins; do
    bindkey -M "$km" '\et' fzf-file-widget
    bindkey -M "$km" '\er' fzf-history-widget
  done

  # Alt+F: search only files (paste matching file path).
  fzf-file-search-widget() {
    local cmd="rg --files -uu --hidden 2>/dev/null"
    FZF_CTRL_T_COMMAND="$cmd" fzf-file-widget
  }
  zle -N fzf-file-search-widget
  for km in emacs vicmd viins; do
    bindkey -M "$km" '\ef' fzf-file-search-widget
  done
fi

# Atuin (cross-shell history) + zoxide. Sourced once, after zvm has already
# initialized above, so atuin's Ctrl-R / vicmd bindings win over zvm's and
# ZSH_AUTOSUGGEST_STRATEGY is extended exactly once.
eval "$(atuin init zsh)"
eval "$(zoxide init zsh)"

# fzf paints itself in the terminal, so the Neovim highlights never reach it.
# scripts/theme rewrites this file on every switch and `theme set` cannot reload
# a running shell, so it is sourced once per shell instead.
[[ -r "$HOME/.config/theme-switcher/fzf-theme.zsh" ]] && source "$HOME/.config/theme-switcher/fzf-theme.zsh"