+impl Client {
+    pub fn matches(&self, other: &Client) -> bool {
+        match (self, other) {
+            (Client::Class(pattern), Client::Class(class)) => match_wildcard(pattern, class),
+            _ => self == other,
+        }
+    }
+}
+
+fn match_wildcard(pattern: &str, text: &str) -> bool {
+    if !pattern.contains('*') {
+        return pattern == text;
+    }
+    let parts: Vec<&str> = pattern.split('*').collect();
+    let mut pos = 0;
+    for (index, part) in parts.iter().enumerate() {
+        if part.is_empty() {
+            continue;
+        }
+        if index == 0 {
+            if !text.starts_with(part) {
+                return false;
+            }
+            pos = part.len();
+        } else if index == parts.len() - 1 {
+            return text[pos..].ends_with(part);
+        } else if let Some(found) = text[pos..].find(part) {
+            pos += found + part.len();
+        } else {
+            return false;
+        }
+    }
+    true
+}
