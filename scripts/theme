#!/usr/bin/env bash
#
# theme — hot-swap the desktop colour scheme at runtime (no rebuild).
#
# Reads the generic theme DB exported by modules/config/colors and drives:
#   * The four terminals via runtime theme files that their declarative
#     home-manager configs include/import/source:
#       - kitty      ~/.config/theme-switcher/kitty-theme.conf
#       - alacritty  ~/.config/theme-switcher/alacritty-theme.toml
#       - wezterm    ~/.config/theme-switcher/wezterm-theme.lua
#       - tmux       ~/.config/theme-switcher/tmux-theme.conf
#   * Noctalia v5 native theming (palette JSON + [theme] header)
#   * The GTK/Qt icon theme (Papirus) + gsettings dark/light
#   * Live reloads (kitty USR1, tmux source-file, Noctalia, hyprctl)
#
# Usage:
#   theme Catppuccin Macchiato Mauve     Switch to a theme/variant/accent
#   theme set Catppuccin Macchiato Mauve Same as above (explicit subcommand)
#   theme set dracula dark default        Any theme in the DB (theme-agnostic)
#   theme list                           List themes, variants and accents
#   theme current                        Show the active selection
#
set -euo pipefail

SCHEMES="$HOME/.local/share/theme-switcher/themes.json"
STATE="$HOME/.local/share/theme-switcher/current"
CFG="$HOME/.config/theme-switcher"

PALETTES_DIR="$HOME/.config/noctalia/palettes"
PALETTE_NAME="themeswapper"
PALETTE_JSON="$PALETTES_DIR/$PALETTE_NAME.json"
NOCTALIA_CFG="$HOME/.config/noctalia/noctalia-config.toml"

require() { command -v "$1" >/dev/null 2>&1 || { echo "error: $1 not found" >&2; exit 1; }; }
[[ -f "$SCHEMES" ]] || { echo "error: $SCHEMES missing (rebuild home-manager)" >&2; exit 1; }
require jq

themes_list()  { jq -r 'keys[]' "$SCHEMES"; }
variants_of()  { jq -r --arg t "$1" '.[$t].flavors | keys[]' "$SCHEMES"; }
accents_of()   { jq -r --arg t "$1" --arg v "$2" '.[$t].flavors[$v].accents | keys[]' "$SCHEMES"; }

# Case-insensitive lookup: return the canonical key matching $x, or empty.
ci_key() { # $1 = jq path to the object whose keys we search, $2 = search value
  local path="$1" want="$2"
  jq -r --arg w "$(echo "${want,,}")" --arg w2 "$want" \
    "[ $path | to_entries[] | select((.key|ascii_downcase)==\$w or (.key|ascii_downcase)==(\$w2|ascii_downcase)) | .key ][0] // empty" "$SCHEMES"
}
ci_theme()   { ci_key '. ' "$1"; }
ci_variant() { ci_key ".[\"$1\"].flavors" "$2"; }
ci_accent()  { ci_key ".[\"$1\"].flavors[\"$2\"].accents" "$3"; }

# Resolve theme/variant/accent into normalized roles (raw hex, no '#').
# Emits JSON: { theme, variant, accentName, accent, polarity, base..text, ansi }
resolve_json() {
  local theme="$1" variant="$2" accent="$3"
  jq -c --arg t "$theme" --arg v "$variant" --arg a "$accent" '
    .[$t] as $th |
    ($th.flavors[$v]) as $f |
    # A custom hex accent ("#aabbcc" / "aabbcc") bypasses the named accent map.
    ( (($a | sub("^#"; "")) | test("^[0-9a-fA-F]{6}$")) as $isHex |
      if $isHex then
        ($f.accents[$a] // $f.accents.default // ($f.accents | to_entries[0].value)) as $fallback |
        {
          theme: $t, variant: $v,
          accentName: ($a | sub("^#"; "")),
          accent: ($a | sub("^#"; "")),
          polarity: $f.polarity,
          title: (($th.title // $t) + " " + ($f.title // $v)),
          base: $f.base, mantle: $f.mantle, crust: $f.crust,
          surface0: $f.surface0, surface1: $f.surface1, surface2: $f.surface2,
          overlay0: $f.overlay0, overlay1: $f.overlay1, overlay2: $f.overlay2,
          subtext0: $f.subtext0, subtext1: $f.subtext1,
          text: $f.text, ansi: $f.ansi,
          secondary: ($f.ansi[4]), tertiary: ($f.ansi[6]), hover: ($f.ansi[2])
        }
      else
        (($f.accents[$a]) // ($f.accents.default) // ($f.accents | to_entries[0].value)) as $acc |
        {
          theme: $t,
          variant: $v,
          accentName: (if $f.accents[$a] then $a else ((if $f.accents.default then "default" else ($f.accents | keys[0]) end)) end),
          accent: $acc,
      polarity: $f.polarity,
      title: (($th.title // $t) + " " + ($f.title // $v)),
      base: $f.base, mantle: $f.mantle, crust: $f.crust,
      surface0: $f.surface0, surface1: $f.surface1, surface2: $f.surface2,
      overlay0: $f.overlay0, overlay1: $f.overlay1, overlay2: $f.overlay2,
      subtext0: $f.subtext0, subtext1: $f.subtext1,
      text: $f.text,
      ansi: $f.ansi,
      # Theme-agnostic secondary/tertiary/hover accents derived from the ANSI
      # palette (blue / cyan / green) so Material roles stay populated for any
      # theme even when it lacks Catppuccin-style named accent colors.
      secondary: ($f.ansi[4]),
      tertiary:  ($f.ansi[6]),
      hover:     ($f.ansi[2])
    }
      end
    )' "$SCHEMES"
}

# Validate theme/variant exist; resolve the accent with case-insensitive names.
# Sets RJSON via global.
RJSON=""
check_sel() {
  local theme="$1" variant="$2" accent="${3:-}"
  local ctheme cvariant caccent
  ctheme=$(ci_theme "$theme")
  [[ -n "$ctheme" ]] || { echo "error: unknown theme '$theme'" >&2; die_list_themes; }
  cvariant=$(ci_variant "$ctheme" "$variant")
  [[ -n "$cvariant" ]] || { echo "error: unknown variant '$variant' for '$ctheme'" >&2; die_list_variants "$ctheme"; }
  if [[ -z "$accent" ]]; then
    caccent=$(jq -r --arg t "$ctheme" --arg v "$cvariant" '.[$t].flavors[$v].accents | (if has("default") then "default" else keys[0] end)' "$SCHEMES")
  elif grep -qiE '^#?[0-9a-f]{6}$' <<<"$accent"; then
    # Custom hex accent: pass through raw so resolve_json injects it verbatim.
    caccent="$accent"
  else
    caccent=$(ci_accent "$ctheme" "$cvariant" "$accent")
    [[ -n "$caccent" ]] || {
      echo "error: unknown accent '$accent' for '$ctheme/$cvariant'" >&2
      die_list_accents "$ctheme" "$cvariant"
    }
  fi
  RJSON=$(resolve_json "$ctheme" "$cvariant" "$caccent")
}

die_list_themes()   { echo "available themes: $(themes_list | paste -sd' ')" >&2; exit 1; }
die_list_variants() { echo "available variants: $(variants_of "$1" | paste -sd' ')" >&2; exit 1; }
die_list_accents()  { echo "available accents: $(accents_of "$1" "$2" | paste -sd' ')" >&2; exit 1; }

# jq helper to read a field from RJSON.
f() { jq -r "$1" <<<"$RJSON"; }

write_runtime_files() {
  mkdir -p "$CFG"
  local accent fg bg
  accent=$(f '.accent'); fg=$(f '.text'); bg=$(f '.crust')

  # --- kitty -----------------------------------------------------------
  cat > "$CFG/kitty-theme.conf" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
background $(f '.crust' | sed 's/^/#/')
foreground $(f '.text' | sed 's/^/#/')
selection_background $(f '.accent' | sed 's/^/#/')
selection_foreground $(f '.crust' | sed 's/^/#/')
url_color $(f '.accent' | sed 's/^/#/')
active_border_color $(f '.accent' | sed 's/^/#/')
inactive_border_color $(f '.overlay1' | sed 's/^/#/')
active_tab_foreground $(f '.crust' | sed 's/^/#/')
active_tab_background $(f '.accent' | sed 's/^/#/')
inactive_tab_foreground $(f '.text' | sed 's/^/#/')
inactive_tab_background $(f '.mantle' | sed 's/^/#/')
tab_bar_background $(f '.crust' | sed 's/^/#/')
$(jq -r '.ansi | to_entries[] | "color" + (.key|tostring) + " #" + .value' <<<"$RJSON")
EOF

  # --- alacritty --------------------------------------------------------
  cat > "$CFG/alacritty-theme.toml" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
[colors]
primary = { background = "#$bg", foreground = "#$fg" }
cursor = { text = "#$(f '.crust')", cursor = "#$accent" }
selection = { text = "#$(f '.crust')", background = "#$accent" }

[colors.normal]
black   = "#$(jq -r '.ansi[0]'  <<<"$RJSON")"
red     = "#$(jq -r '.ansi[1]'  <<<"$RJSON")"
green   = "#$(jq -r '.ansi[2]'  <<<"$RJSON")"
yellow  = "#$(jq -r '.ansi[3]'  <<<"$RJSON")"
blue    = "#$(jq -r '.ansi[4]'  <<<"$RJSON")"
magenta = "#$(jq -r '.ansi[5]'  <<<"$RJSON")"
cyan    = "#$(jq -r '.ansi[6]'  <<<"$RJSON")"
white   = "#$(jq -r '.ansi[7]'  <<<"$RJSON")"

[colors.bright]
black   = "#$(jq -r '.ansi[8]'  <<<"$RJSON")"
red     = "#$(jq -r '.ansi[9]'  <<<"$RJSON")"
green   = "#$(jq -r '.ansi[10]' <<<"$RJSON")"
yellow  = "#$(jq -r '.ansi[11]' <<<"$RJSON")"
blue    = "#$(jq -r '.ansi[12]' <<<"$RJSON")"
magenta = "#$(jq -r '.ansi[13]' <<<"$RJSON")"
cyan    = "#$(jq -r '.ansi[14]' <<<"$RJSON")"
white   = "#$(jq -r '.ansi[15]' <<<"$RJSON")"
EOF

  # --- wezterm (returns a table merged into config by extraConfig) ------
  {
    echo "-- Generated by scripts/theme ($(f '.title') / $(f '.accentName'))"
    echo "return {"
    echo "  colors = {"
    echo "    foreground = \"#$fg\","
    echo "    background = \"#$bg\","
    echo "    cursor_bg = \"#$accent\","
    echo "    cursor_fg = \"#$(f '.crust')\","
    echo "    cursor_border = \"#$accent\","
    echo "    selection_fg = \"#$(f '.crust')\","
    echo "    selection_bg = \"#$accent\","
    echo -n "    ansi = {"
    jq -r '.ansi[0:8][]' <<<"$RJSON" | sed 's/^/      "/;s/$/",/' | tr '\n' ' ' | sed 's/^ *//; s/ *$//'
    echo " },"; echo -n "    brights = {"
    jq -r '.ansi[8:16][]' <<<"$RJSON" | sed 's/^/      "/;s/$/",/' | tr '\n' ' ' | sed 's/^ *//; s/ *$//'
    echo " },"
    echo "  },"
    echo "}"
  } > "$CFG/wezterm-theme.lua"

  # --- tmux --------------------------------------------------------------
  # Colors are exposed as runtime tmux variables (@thm_*) that the static
  # pill status bar in modules/config/tmux references lazily (#{@thm_*}),
  # so ./theme recolors the bar with no plugin rebake.
  local gn bu yw te
  gn=$(jq -r '.ansi[2]' <<<"$RJSON")
  bu=$(jq -r '.ansi[4]' <<<"$RJSON")
  yw=$(jq -r '.ansi[3]' <<<"$RJSON")
  te=$(jq -r '.ansi[6]' <<<"$RJSON")
  cat > "$CFG/tmux-theme.conf" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
# Base styles (panes, messages, selection)
set -g status-style "bg=default"
set -g pane-border-style "fg=#$(f '.overlay0')"
set -g pane-active-border-style "fg=#$accent"
set -g message-style "bg=#$(f '.surface0'),fg=#$fg"
set -g message-command-style "bg=#$accent,fg=#$(f '.base')"
set -g mode-style "bg=#$accent,fg=#$(f '.base')"
set -g display-panes-colour "#$accent"
set -g display-panes-active-colour "#$fg"
# Pill status bar colors
set -gq @thm_tab_bg "#$(f '.surface0')"
set -gq @thm_tab_fg "#$fg"
set -gq @thm_tab_accent "#$accent"
set -gq @thm_tab_inactive "#$(f '.overlay2')"
set -gq @thm_on_pill "#$(f '.base')"
set -gq @thm_m_user "#$accent"
set -gq @thm_m_battery "#$bu"
set -gq @thm_m_cpu "#$yw"
set -gq @thm_m_uptime "#$te"
EOF

  # --- hyprland (lua fragment dofiled on hyprctl reload) -------------------
  cat > "$CFG/hyprland-theme.lua" <<EOF
-- Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
return {
  active_border = "0x$accent",
  inactive_border = "0x$(f '.overlay1')",
}
EOF
}

# Point Noctalia's [theme] section at our palette.
set_noctalia_theme() {
  local polarity="$1"
  local mode
  case "$polarity" in
    light) mode="light" ;;
    *) mode="dark" ;;
  esac
  [[ -f "$NOCTALIA_CFG" ]] || return 0
  if grep -q '^\[theme\]' "$NOCTALIA_CFG"; then
    python3 - "$NOCTALIA_CFG" "$PALETTE_NAME" "$mode" <<'PY'
import sys, re
path, name, mode = sys.argv[1:4]
lines = open(path).read().splitlines()
out, in_theme = [], False
for ln in lines:
    s = ln.strip()
    if s == '[theme]':
        in_theme = True; out.append(ln); continue
    if in_theme and s.startswith('[') and not s.startswith('[theme.'):
        in_theme = False
    if in_theme:
        if re.match(r'^source\s*=', s):      out.append('source = "custom"'); continue
        if re.match(r'^custom_palette\s*=', s): out.append(f'custom_palette = "{name}"'); continue
        if re.match(r'^mode\s*=', s):        out.append(f'mode = "{mode}"'); continue
        if s.startswith('builtin'):          continue
    out.append(ln)
open(path, 'w').write('\n'.join(out) + '\n')
PY
  else
    printf '\n[theme]\nsource = "custom"\ncustom_palette = "%s"\nmode = "%s"\n' "$PALETTE_NAME" "$mode" >> "$NOCTALIA_CFG"
  fi
}

# Build the Noctalia palette JSON for the resolved roles + accent.
gen_noctalia_palette() {
  mkdir -p "$PALETTES_DIR"
  jq -c --arg pol "$(f '.polarity')" '
    {
      ($pol): {
        mPrimary: "#"+.accent,
        mSecondary: "#"+.secondary,
        mTertiary: "#"+.tertiary,
        mSurface: "#"+.base,
        mSurfaceVariant: "#"+.surface0,
        mOnSurface: "#"+.text,
        mOnSurfaceVariant: "#"+.subtext0,
        mOnPrimary: "#"+.base,
        mOnSecondary: "#"+.mantle,
        mOnTertiary: "#"+.mantle,
        mOutline: "#"+.overlay0,
        mError: "#"+(.ansi[1]|tostring),
        mHover: "#"+.hover,
        mOnError: "#"+.base,
        mOnHover: "#"+.base,
        mShadow: "#"+.crust,
        terminal: {
          background: "#"+.crust,
          foreground: "#"+.text,
          cursor: "#"+.text,
          cursorText: "#"+.base,
          selectionBg: "#"+.surface1,
          selectionFg: "#"+.text,
          normal: {
            black:   "#"+(.ansi[0]|tostring),
            red:     "#"+(.ansi[1]|tostring),
            green:   "#"+(.ansi[2]|tostring),
            yellow:  "#"+(.ansi[3]|tostring),
            blue:    "#"+(.ansi[4]|tostring),
            magenta: "#"+.accent,
            cyan:    "#"+(.ansi[6]|tostring),
            white:   "#"+(.ansi[7]|tostring)
          },
          bright: {
            black:   "#"+(.ansi[8]|tostring),
            red:     "#"+(.ansi[9]|tostring),
            green:   "#"+(.ansi[10]|tostring),
            yellow:  "#"+(.ansi[11]|tostring),
            blue:    "#"+(.ansi[12]|tostring),
            magenta: "#"+(.ansi[13]|tostring),
            cyan:    "#"+(.ansi[14]|tostring),
            white:   "#"+(.ansi[15]|tostring)
          }
        }
      }
    }' <<<"$RJSON" > "$PALETTE_JSON"
}

# Apply runtime changes across the stack.
apply() {
  local polarity label="$1"
  # Icons + platform colour scheme follow the polarity (Papirus themes).
  if command -v gsettings >/dev/null 2>&1; then
    if [[ "$polarity" == "light" ]]; then
      gsettings set org.gnome.desktop.interface color-scheme prefer-light
      gsettings set org.gnome.desktop.interface icon-theme Papirus-Light
    else
      gsettings set org.gnome.desktop.interface color-scheme prefer-dark
      gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark
    fi
  fi
  # Terminals
  if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
    tmux source-file "$CFG/tmux-theme.conf" >/dev/null 2>&1 || true
    # Repaint the whole status line so the right segment re-renders cleanly
    # (source-file alone can leave stale background/style on part of the bar).
    tmux refresh-client -S >/dev/null 2>&1 || true
  fi
  if command -v kitty >/dev/null 2>&1; then
    pkill -USR1 kitty >/dev/null 2>&1 || true
  fi
  # Noctalia + Hyprland
  if command -v noctalia >/dev/null 2>&1; then
    noctalia msg config reload >/dev/null 2>&1 || true
    noctalia msg templates apply >/dev/null 2>&1 || true
  fi
  hyprctl reload >/dev/null 2>&1 || true
  # wezterm auto-reloads via its watch list when the theme file changes.
  notify-send "Theme" "Switched to $label" >/dev/null 2>&1 || true
}

cmd_set() {
  check_sel "$@"
  local polarity
  polarity=$(f '.polarity')
  gen_noctalia_palette
  write_runtime_files
  set_noctalia_theme "$polarity"
  mkdir -p "$(dirname "$STATE")"
  printf '%s %s %s\n' "$(f '.theme')" "$(f '.variant')" "$(f '.accentName')" > "$STATE"
  apply "$(f '.title') ($(f '.accentName'))"
  echo "theme: $(f '.title') / $(f '.accentName')"
}

cmd_list() {
  for t in $(themes_list); do
    echo "Theme: $t"
    for v in $(variants_of "$t"); do
      printf '  %-12s (%s) accents: %s\n' "$v" "$(jq -r --arg t "$t" --arg v "$v" '.[$t].flavors[$v].polarity' "$SCHEMES")" "$(accents_of "$t" "$v" | paste -sd' ')"
    done
  done
}

cmd_current() {
  if [[ -f "$STATE" ]]; then
    echo "current: $(cat "$STATE")"
  else
    echo "current: <unset> — using build-time default (Catppuccin macchiato mauve)"
  fi
}

cmd="${1:-}"
if [[ "$cmd" == "set" ]]; then
  shift
  cmd_set "${1:?theme required}" "${2:?variant required}" "${3:-}"
elif [[ "$cmd" =~ ^(list|-l)$ ]]; then
  cmd_list
elif [[ "$cmd" =~ ^(current|status)$ ]]; then
  cmd_current
elif [[ "$cmd" =~ ^(help|-h|--help)$ ]]; then
  echo "usage:"
  echo "  $0 <theme> <variant> [accent]"
  echo "  $0 set <theme> <variant> [accent]"
  echo "  $0 list"
  echo "  $0 current"
  exit 0
elif [[ -n "$cmd" ]]; then
  # Bare form: theme variant optional-accent
  cmd_set "$cmd" "${2:?variant required}" "${3:-}"
else
  echo "usage: $0 {<theme> <variant> [accent] | set <theme> <variant> [accent] | list | current}" >&2
  exit 1
fi
