#!/usr/bin/env bash
#
# theme — switch the desktop colour scheme and keep Stylix in sync.
#
# Terminal/tmux/noctalia/icon changes apply live (no rebuild). Stylix
# (GTK/KDE/Qt/..) renders its colors at build time, so `theme set` also writes
# the tracked modules/home/config/themes/colors/src/selection file and rebuilds
# home-manager so the desktop follows the same selection. Noctalia's config.toml
# (HM-managed) is also updated by the rebuild. Pass --runtime to skip the rebuild
# and --system to ALSO switch the NixOS system (console/plymouth; needs polkit).
#
# Reads the generic theme DB exported by modules/config/colors and drives:
#   * The five terminals via runtime theme files that their declarative
#     home-manager configs include/import/source/theme:
#       - kitty      ~/.config/theme-switcher/kitty-theme.conf
#       - alacritty  ~/.config/theme-switcher/alacritty-theme.toml
#       - wezterm    ~/.config/theme-switcher/wezterm-theme.lua
#       - ghostty    ~/.config/theme-switcher/ghostty-theme.conf
#                   (built-in theme + full ANSI palette override)
#       - tmux       ~/.config/theme-switcher/tmux-theme.conf
#       - neovim     ~/.config/theme-switcher/nvim-base16.lua
#                   (base16 palette, applied by nvim's lua/theme.lua)
#   * Apps that only accept a file path, rewritten in place on every switch:
#       - herdr      [theme.custom] block in ~/.config/herdr/config.toml
#       - superfile  ~/.config/superfile/theme/theme-switcher.toml
#       - rofi       ~/.config/rofi/colors/theme-switcher.rasi
#       - qutebrowser ~/.config/qutebrowser/noctalia/colors.py
#       - hyprlock   the $hl_* variables in ~/.config/hypr/hyprlock.conf
#   * Noctalia v5+ native theming (palette JSON + config.toml via HM)
#   * The GTK/Qt icon theme (Papirus) + gsettings dark/light
#   * Live reloads (kitty USR1, nvim USR1, tmux source-file, noctalia msg config-reload + templates-apply, hyprctl)
#
# Usage:
#   theme Catppuccin Macchiato Mauve     Switch to a theme/variant/accent
#   theme set Catppuccin Macchiato Mauve Same as above (explicit subcommand)
#   theme set dracula dark default        Any theme in the DB (theme-agnostic)
#   theme mutagen                        Derive a Material You palette from the
#                                         wallpaper Noctalia currently applies
#   theme list                           List themes, variants and accents
#   theme current                        Show the active selection
#
set -euo pipefail

SCHEMES="$HOME/.local/share/theme-switcher/themes.json"
STATE="$HOME/.local/share/theme-switcher/current"
CFG="$HOME/.config/theme-switcher"

# Tracked build-time selection (drives Stylix + build-time defaults).
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SELECTION="$REPO_ROOT/modules/home/config/themes/colors/src/selection"

PALETTES_DIR="$HOME/.config/noctalia/palettes"
PALETTE_NAME="themeswapper"
PALETTE_JSON="$PALETTES_DIR/$PALETTE_NAME.json"

require() { command -v "$1" >/dev/null 2>&1 || { echo "error: $1 not found" >&2; exit 1; }; }
[[ -f "$SCHEMES" ]] || { echo "error: $SCHEMES missing (rebuild home-manager)" >&2; exit 1; }
require jq

themes_list()  { jq -r 'keys[]' "$SCHEMES"; }
variants_of()  { jq -r --arg t "$1" '.[$t].flavors | keys[]' "$SCHEMES"; }
accents_of()   { jq -r --arg t "$1" --arg v "$2" '.[$t].flavors[$v].accents | keys[]' "$SCHEMES"; }

# Case-insensitive lookup: return the canonical key matching $x, or empty.
ci_key() { # $1 = jq path to the object whose keys we search, $2 = search value
  local path="$1" want="$2"
  jq -r --arg w "$(echo "${want,,}")" --arg w2 "$want" \
    "[ $path | to_entries[] | select((.key|ascii_downcase)==\$w or (.key|ascii_downcase)==(\$w2|ascii_downcase)) | .key ][0] // empty" "$SCHEMES"
}
ci_theme()   { ci_key '. ' "$1"; }
ci_variant() { ci_key ".[\"$1\"].flavors" "$2"; }
# Keep in sync with accentAliases in themes.nix (also consulted by the Nix-side
# `resolve`); an alias only applies when the flavor has no key of that name.
ci_accent() {
  local got; got=$(ci_key ".[\"$1\"].flavors[\"$2\"].accents" "$3")
  [[ -n "$got" ]] && { echo "$got"; return 0; }
  local want="${3,,}" alias
  for alias in "${!ACCENT_ALIASES[@]}"; do
    if [[ "${alias,,}" == "$want" ]]; then
      ci_key ".[\"$1\"].flavors[\"$2\"].accents" "${ACCENT_ALIASES[$alias]}"
      return
    fi
  done
  echo ""
}

# accentAliases in themes.nix: upstream accent names -> this DB's key names.
declare -A ACCENT_ALIASES=(
  [sky]=cyan [frost]=cyan [polar]=blue [aurora]=green
  [pink]=purple [iris]=purple [love]=red [foam]=cyan
  [gold]=yellow [pine]=green
  [waveBlue]=sapphire [lotusPink]=purple [dragonBlue]=blue
)

# Resolve theme/variant/accent into normalized roles (raw hex, no '#').
# Emits JSON: { theme, variant, accentName, accent, polarity, base..text, ansi }
resolve_json() {
  local theme="$1" variant="$2" accent="$3"
  jq -c --arg t "$theme" --arg v "$variant" --arg a "$accent" '
    .[$t] as $th |
    ($th.flavors[$v]) as $f |
    # Named accent colors (catppuccin-style). Fall back to ANSI-derived values so
    # non-catppuccin themes still get sensible module hues.
    ( $f.accents as $ac |
      {
        mauve:   ($ac.mauve   // .[$t].flavors[$v].base),
        red:     ($ac.red     // $f.base),
        maroon:  ($ac.maroon  // $f.ansi[9] // $f.ansi[1]),
        green:   ($ac.green   // $f.ansi[2] // $f.base),
        yellow:  ($ac.yellow  // $f.ansi[3] // $f.base),
        blue:    ($ac.blue    // $f.ansi[4] // $f.base),
        sapphire:($ac.sapphire // $f.ansi[12] // $f.ansi[4]),
        sky:     ($ac.sky // $ac.teal // $f.ansi[11] // $f.ansi[6]),
        lavender:($ac.lavender // $f.ansi[15] // $f.base),
        teal:    ($ac.teal    // $f.ansi[6] // $f.base)
      } ) as $NA |
    # The base16 slots consumed by the nvim palette (see themes.nix `toBase16`)
    # need the remaining catppuccin-style names; ANSI-derived fallbacks keep them
    # identical to the build-time file for non-catppuccin themes.
    ( $f.accents as $ac |
      {
        rosewater:($ac.rosewater // $f.ansi[7]),
        lavender: ($ac.lavender  // $f.ansi[15]),
        red:      ($ac.red       // $f.ansi[1]),
        peach:    ($ac.peach // $ac.orange // $f.ansi[3]),
        orange:   ($ac.orange    // $f.ansi[3]),
        yellow:   ($ac.yellow    // $f.ansi[3]),
        green:    ($ac.green     // $f.ansi[2]),
        teal:     ($ac.teal // $ac.cyan // $f.ansi[6]),
        cyan:     ($ac.cyan      // $f.ansi[6]),
        mauve:    ($ac.mauve // $ac.purple // $f.ansi[5]),
        purple:   ($ac.purple    // $f.ansi[5]),
        flamingo: ($ac.flamingo // $ac.maroon // $f.ansi[9])
      } ) as $B16 |
    # A custom hex accent ("#aabbcc" / "aabbcc") bypasses the named accent map.
    ( (($a | sub("^#"; "")) | test("^[0-9a-fA-F]{6}$")) as $isHex |
      if $isHex then
        ($f.accents[$a] // $f.accents.default // ($f.accents | to_entries[0].value)) as $fallback |
        {
          theme: $t, variant: $v,
          accentName: ($a | sub("^#"; "")),
          accent: ($a | sub("^#"; "")),
          polarity: $f.polarity,
          title: (($th.title // $t) + " " + ($f.title // $v)),
          base: $f.base, mantle: $f.mantle, crust: $f.crust,
          surface0: $f.surface0, surface1: $f.surface1, surface2: $f.surface2,
          overlay0: $f.overlay0, overlay1: $f.overlay1, overlay2: $f.overlay2,
          subtext0: $f.subtext0, subtext1: $f.subtext1,
          text: $f.text, ansi: $f.ansi,
          named: $NA,
          base16: $B16,
          secondary: ($f.ansi[4]), tertiary: ($f.ansi[6]), hover: ($f.ansi[2])
        }
      else
        ((if $a == "default" then $f.text else (($f.accents[$a]) // ($f.accents.default) // ($f.accents | to_entries[0].value)) end)) as $acc |
        {
          theme: $t,
          variant: $v,
          accentName: (if $a == "default" then "default" else (if $f.accents[$a] then $a else ((if $f.accents.default then "default" else ($f.accents | keys[0]) end)) end) end),
          accent: $acc,
      polarity: $f.polarity,
      title: (($th.title // $t) + " " + ($f.title // $v)),
      base: $f.base, mantle: $f.mantle, crust: $f.crust,
      surface0: $f.surface0, surface1: $f.surface1, surface2: $f.surface2,
      overlay0: $f.overlay0, overlay1: $f.overlay1, overlay2: $f.overlay2,
      subtext0: $f.subtext0, subtext1: $f.subtext1,
      text: $f.text,
      ansi: $f.ansi,
      named: $NA,
      base16: $B16,
      # Theme-agnostic secondary/tertiary/hover accents derived from the ANSI
      # palette (blue / cyan / green) so Material roles stay populated for any
      # theme even when it lacks Catppuccin-style named accent colors.
      secondary: ($f.ansi[4]),
      tertiary:  ($f.ansi[6]),
      hover:     ($f.ansi[2])
    }
      end
    )' "$SCHEMES"
}

# Validate theme/variant exist; resolve the accent with case-insensitive names.
# Sets RJSON via global.
RJSON=""
check_sel() {
  local theme="$1" variant="$2" accent="${3:-}"
  local ctheme cvariant caccent
  ctheme=$(ci_theme "$theme")
  [[ -n "$ctheme" ]] || { echo "error: unknown theme '$theme'" >&2; die_list_themes; }
  cvariant=$(ci_variant "$ctheme" "$variant")
  [[ -n "$cvariant" ]] || { echo "error: unknown variant '$variant' for '$ctheme'" >&2; die_list_variants "$ctheme"; }
  if [[ -z "$accent" ]]; then
    # "default" when the flavor declares one (every non-Catppuccin flavor does),
    # else fall back to the theme's accent-ish keys in the same priority order
    # themes.nix uses, rather than alphabetically-first `blue`.
    caccent=$(jq -r --arg t "$ctheme" --arg v "$cvariant" '
      .[$t].flavors[$v].accents as $a
      | if $a | has("default") then "default"
        else (["mauve","lavender","purple","rosewater","blue","sapphire","cyan"]
              | map(select(. as $k | $a | has($k))) | .[0] // ($a | keys[0]))
        end' "$SCHEMES")
  elif [[ "${accent,,}" == "default" ]]; then
    # "Default" accent = the theme's primary text color.
    caccent="default"
  elif grep -qiE '^#?[0-9a-f]{6}$' <<<"$accent"; then
    # Custom hex accent: pass through raw so resolve_json injects it verbatim.
    caccent="$accent"
  else
    caccent=$(ci_accent "$ctheme" "$cvariant" "$accent")
    [[ -n "$caccent" ]] || {
      echo "error: unknown accent '$accent' for '$ctheme/$cvariant'" >&2
      die_list_accents "$ctheme" "$cvariant"
    }
  fi
  RJSON=$(resolve_json "$ctheme" "$cvariant" "$caccent")
}

die_list_themes()   { echo "available themes: $(themes_list | paste -sd' ')" >&2; exit 1; }
die_list_variants() { echo "available variants: $(variants_of "$1" | paste -sd' ')" >&2; exit 1; }
die_list_accents()  { echo "available accents: $(accents_of "$1" "$2" | paste -sd' ')" >&2; exit 1; }

# jq helper to read a field from RJSON.
f() { jq -r "$1" <<<"$RJSON"; }

# [theme.custom] block for herdr, built from the active palette. Assigned to
# HERDR_THEME_BLOCK by gen_herdr_theme once RJSON is available.
HERDR_THEME_BLOCK=""
gen_herdr_theme_block() {
  local b16='.base16' na='.named'
  local mauve peach green yellow red blue teal
  mauve=$(f "$b16.mauve"); peach=$(f "$b16.peach")
  green=$(f "$na.green"); yellow=$(f "$na.yellow")
  red=$(f "$na.red"); blue=$(f "$na.blue"); teal=$(f "$na.teal")
  HERDR_THEME_BLOCK=$(cat <<EOF
# Managed by scripts/theme ($(f '.title') / $(f '.accentName')) — regenerated
# on every switch; other sections in this file are left untouched.
[theme]
name = "$(f '.title')"

[theme.custom]
accent = "#$(f '.accent')"
panel_bg = "#$(f '.mantle')"
active_row_bg = "#$(f '.base')"
selection_bg = "#$(f '.surface0')"
surface0 = "#$(f '.surface0')"
surface1 = "#$(f '.surface1')"
surface_dim = "#$(f '.crust')"
overlay0 = "#$(f '.overlay0')"
overlay1 = "#$(f '.overlay1')"
text = "#$(f '.text')"
subtext0 = "#$(f '.subtext0')"
mauve = "#$mauve"
green = "#$green"
yellow = "#$yellow"
red = "#$red"
blue = "#$blue"
teal = "#$teal"
peach = "#$peach"
EOF
  )
}

gen_hermes_skin() {
  # Generate a Hermes skin YAML that follows the active theme-switcher palette.
  # Uses RJSON (set by check_sel); writes the skin and activates it via config.
  local skins_dir
  skins_dir="${HERMES_HOME:-$HOME/.hermes}/skins"
  mkdir -p "$skins_dir"
  local skin="$skins_dir/theme-switcher.yaml"
  local bg text sub0 ov0 accent green yellow red bred cyan magenta base mantle sf0 sf1 sf2
  bg=$(f '.crust')
  text=$(f '.text')
  sub0=$(f '.subtext0')
  ov0=$(f '.overlay0')
  accent=$(f '.accent')
  green=$(jq -r '.ansi[2]' <<<"$RJSON")
  yellow=$(jq -r '.ansi[3]' <<<"$RJSON")
  red=$(jq -r '.ansi[1]' <<<"$RJSON")
  bred=$(jq -r '.ansi[9]' <<<"$RJSON")
  cyan=$(jq -r '.ansi[6]' <<<"$RJSON")
  magenta=$(jq -r '.ansi[5]' <<<"$RJSON")
  base=$(f '.base')
  mantle=$(f '.mantle')
  sf0=$(f '.surface0')
  sf1=$(f '.surface1')
  sf2=$(f '.surface2')
  cat > "$skin" <<EOF
# Auto-generated by scripts/theme from the theme-switcher palette.
# Do not edit manually — run 'theme hermes' or switch themes to regenerate.
name: theme-switcher
description: "Follows the theme-switcher: $(f '.title') / $(f '.accentName')"

colors:
  background: "#$bg"
  ui_accent: "#$accent"
  ui_tool: "#$accent"
  banner_accent: "#$accent"
  ui_thinking: "#$sub0"
  banner_title: "#$text"
  ui_primary: "#$text"
  ui_text: "#$text"
  banner_text: "#$text"
  ui_label: "#$text"
  banner_dim: "#$sub0"
  ui_border: "#$ov0"
  banner_border: "#$ov0"
  prompt: "#$accent"
  input_rule: "#$accent"
  ui_ok: "#$green"
  ui_warn: "#$accent"
  ui_error: "#$accent"
  status_bar_bg: "#$mantle"
  status_bar_text: "#$text"
  status_bar_good: "#$green"
  status_bar_warn: "#$accent"
  status_bar_bad: "#$accent"
  status_bar_critical: "#$accent"
  diff_added: "#$green"
  diff_removed: "#$accent"
  diff_added_word: "#$green"
  diff_removed_word: "#$accent"
  syntax_string: "#$cyan"
  syntax_number: "#$accent"
  syntax_keyword: "#$magenta"
  syntax_comment: "#$sub0"
  completion_menu_bg: "#$sf0"
  completion_menu_current_bg: "#$sf1"
  completion_menu_meta_bg: "#$sf2"
  completion_menu_fg: "#$text"
  completion_menu_current_fg: "#$text"
EOF
  hermes config set display.skin theme-switcher 2>/dev/null || true
  notify-send "Theme" "Hermes skin updated to $(f '.title') / $(f '.accentName')" 2>/dev/null || true
}

# herdr keeps its palette in a TOML config the app rewrites itself, so it is
# NOT a generated file — rewrite only the [theme] block on every switch,
# preserving the user's [keys]/[ui] sections. Reads the managed file so the
# Nix-side defaults (see modules/herdr) apply on first run.
# superfile only ships fixed theme files (catppuccin, gruvbox, nord, ...), so a
# DB-driven theme must be written into its data dir. Default config.toml points
# at "theme-switcher"; see modules/home/config/modules/superfile.
# hyprlock has no include/variable-from-env mechanism, so rewrite only the
# `$hl_*=` variable lines in place. Everything else in hyprlock.conf (positions,
# commands, fonts) is left byte-identical. Under home-manager hyprlock.conf is a
# Nix store symlink, so this is normally a no-op; the build-time
# `config.colors.active` variables in modules/home/.../hyprlock are what follow
# the selection (the default `theme set` rebuild + activates home-manager).
gen_hyprlock_theme() {
  local conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.conf"
  [[ -f "$conf" ]] || return 0
  [[ -w "$conf" ]] || return 0
  sed -i \
    -e "s|^\\\$hl_text=.*|\\\$hl_text=$(f '.text')|" \
    -e "s|^\\\$hl_sub=.*|\\\$hl_sub=$(f '.subtext1')|" \
    -e "s|^\\\$hl_faint=.*|\\\$hl_faint=$(f '.overlay0')|" \
    -e "s|^\\\$hl_surface=.*|\\\$hl_surface=$(f '.surface0')|" \
    "$conf"
}

# rofi resolves colors through themes/shared/colors.rasi, which imports
# colors/theme-switcher.rasi. Written into the MANAGED ~/.config/rofi/colors/
# tree (the old ~/.config/hypr/rofi/colors/ path was an unmanaged leftover).
gen_rofi_colors() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/rofi/colors"
  mkdir -p "$dir"
  local b16='.base16'
  local teal; teal=$(f "$b16.teal")
  cat > "$dir/theme-switcher.rasi" <<EOF
/* Generated by scripts/theme ($(f '.title') / $(f '.accentName')) — do not edit. */
* {
    background:     #$(f '.base');
    text:           #$(f '.text');
    accent:         #$(f '.accent');
    background-alt: #$(f '.mantle')99;
    foreground:     #$(f '.text');
    selected:       #$(f '.accent');
    active:         #$(f '.overlay0');
    urgent:         #$teal;
}
EOF
}

gen_superfile_theme() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/superfile/theme"
  mkdir -p "$dir"
  local b16='.base16' na='.named'
  local purple green red
  purple=$(f "$b16.purple"); green=$(f "$na.green"); red=$(f "$na.red")
  cat > "$dir/theme-switcher.toml" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName')) — do not edit.
# Syntax highlighting is chroma-side and independent of the superfile palette.
code_syntax_highlight = "monokai"

# ========= Border =========
file_panel_border = "#$(f '.overlay0')"
sidebar_border = "#$(f '.overlay0')"
footer_border = "#$(f '.overlay0')"
sidebar_divider = "#$(f '.overlay0')"

# ========= Border Active =========
file_panel_border_active = "#$(f '.accent')"
sidebar_border_active = "#$(f '.accent')"
footer_border_active = "#$(f '.accent')"
modal_border_active = "#$(f '.accent')"

# ========= Background (bg) =========
full_screen_bg = "#$(f '.base')"
file_panel_bg = "#$(f '.base')"
sidebar_bg = "#$(f '.mantle')"
footer_bg = "#$(f '.crust')"
modal_bg = "#$(f '.surface0')"

# ========= Foreground (fg) =========
full_screen_fg = "#$(f '.text')"
file_panel_fg = "#$(f '.text')"
sidebar_fg = "#$(f '.text')"
footer_fg = "#$(f '.text')"
modal_fg = "#$(f '.text')"

# ========= Selection =========
file_panel_item_selected_bg = "#$(f '.accent')"
file_panel_item_selected_fg = "#$(f '.crust')"
sidebar_item_selected_bg = "#$(f '.accent')"
sidebar_item_selected_fg = "#$(f '.crust')"

# ========= Header / hint text =========
file_panel_top_directory_icon = "#$(f '.accent')"
file_panel_top_path = "#$(f '.accent')"
sidebar_title = "#$(f '.accent')"
gradient_color = "#$purple"
hint = "#$(f '.subtext0')"
cursor = "#$(f '.text')"

# ========= Help menu =========
help_menu_title = "#$(f '.accent')"
help_menu_hotkey = "#$(f '.accent')"

# ========= Modal buttons =========
modal_confirm_bg = "#$green"
modal_confirm_fg = "#$(f '.crust')"
modal_cancel_bg = "#$(f '.surface1')"
modal_cancel_fg = "#$(f '.subtext0')"

# ========= Spinner / status =========
correct = "#$green"
error = "#$red"
cancel = "#$(f '.subtext1')"
EOF
}

gen_herdr_theme() {
  local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/herdr/config.toml"
  mkdir -p "$(dirname "$cfg")"
  printf '%s\n' "$HERDR_THEME_BLOCK" > "$cfg.tmp"
  # Drop every [theme*] section (including [theme.custom]) from the existing
  # file, keep [keys]/[ui]/anything else the user added.
  if [[ -f "$cfg" ]]; then
    awk '
      /^\[theme/ { skip = 1; next }
      /^\[/      { skip = 0 }
      !skip     { print }
    ' "$cfg" >> "$cfg.tmp"
  fi
  mv "$cfg.tmp" "$cfg"
}

write_runtime_files() {
  mkdir -p "$CFG"
  local accent fg bg
  accent=$(f '.accent'); fg=$(f '.text'); bg=$(f '.crust')

  # --- kitty -----------------------------------------------------------
  cat > "$CFG/kitty-theme.conf" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
background $(f '.crust' | sed 's/^/#/')
foreground $(f '.text' | sed 's/^/#/')
selection_background $(f '.accent' | sed 's/^/#/')
selection_foreground $(f '.crust' | sed 's/^/#/')
url_color $(f '.accent' | sed 's/^/#/')
active_border_color $(f '.accent' | sed 's/^/#/')
inactive_border_color $(f '.overlay1' | sed 's/^/#/')
active_tab_foreground $(f '.crust' | sed 's/^/#/')
active_tab_background $(f '.accent' | sed 's/^/#/')
inactive_tab_foreground $(f '.text' | sed 's/^/#/')
inactive_tab_background $(f '.mantle' | sed 's/^/#/')
tab_bar_background $(f '.crust' | sed 's/^/#/')
$(jq -r '.ansi | to_entries[] | "color" + (.key|tostring) + " #" + .value' <<<"$RJSON")
EOF

  # --- alacritty --------------------------------------------------------
  cat > "$CFG/alacritty-theme.toml" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
[colors]
primary = { background = "#$bg", foreground = "#$fg" }
cursor = { text = "#$(f '.crust')", cursor = "#$accent" }
selection = { text = "#$(f '.crust')", background = "#$accent" }

[colors.normal]
black   = "#$(jq -r '.ansi[0]'  <<<"$RJSON")"
red     = "#$(jq -r '.ansi[1]'  <<<"$RJSON")"
green   = "#$(jq -r '.ansi[2]'  <<<"$RJSON")"
yellow  = "#$(jq -r '.ansi[3]'  <<<"$RJSON")"
blue    = "#$(jq -r '.ansi[4]'  <<<"$RJSON")"
magenta = "#$(jq -r '.ansi[5]'  <<<"$RJSON")"
cyan    = "#$(jq -r '.ansi[6]'  <<<"$RJSON")"
white   = "#$(jq -r '.ansi[7]'  <<<"$RJSON")"

[colors.bright]
black   = "#$(jq -r '.ansi[8]'  <<<"$RJSON")"
red     = "#$(jq -r '.ansi[9]'  <<<"$RJSON")"
green   = "#$(jq -r '.ansi[10]' <<<"$RJSON")"
yellow  = "#$(jq -r '.ansi[11]' <<<"$RJSON")"
blue    = "#$(jq -r '.ansi[12]' <<<"$RJSON")"
magenta = "#$(jq -r '.ansi[13]' <<<"$RJSON")"
cyan    = "#$(jq -r '.ansi[14]' <<<"$RJSON")"
white   = "#$(jq -r '.ansi[15]' <<<"$RJSON")"
EOF

  # --- wezterm (returns a table merged into config by extraConfig) ------
  {
    echo "-- Generated by scripts/theme ($(f '.title') / $(f '.accentName'))"
    echo "return {"
    echo "  colors = {"
    echo "    foreground = \"#$fg\","
    echo "    background = \"#$bg\","
    echo "    cursor_bg = \"#$accent\","
    echo "    cursor_fg = \"#$(f '.crust')\","
    echo "    cursor_border = \"#$accent\","
    echo "    selection_fg = \"#$(f '.crust')\","
    echo "    selection_bg = \"#$accent\","
    echo -n "    ansi = {"
    jq -r '.ansi[0:8][]' <<<"$RJSON" | sed 's/^/      "/;s/$/",/' | tr '\n' ' ' | sed 's/^ *//; s/ *$//'
    echo " },"; echo -n "    brights = {"
    jq -r '.ansi[8:16][]' <<<"$RJSON" | sed 's/^/      "/;s/$/",/' | tr '\n' ' ' | sed 's/^ *//; s/ *$//'
    echo " },"
    echo "  },"
    echo "}"
  } > "$CFG/wezterm-theme.lua"

  # --- ghostty (built-in theme + full palette overrides) --------------------
  # Ghostty ships many of these themes as built-ins, but the built-in palette is
  # not guaranteed to match this flavor's ANSI slots and several flavors (Yoru,
  # Mountain, Material You) have no built-in at all, so pin every color
  # explicitly and fall back to the polarity-matched builtin. Mirror of
  # modules/config/colors/default.nix `ghosttyTheme`.
  {
    echo "# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))"
    local gfallback
    gfallback=$(
      jq -r --arg t "$(f '.theme')" --arg v "$(f '.variant')" \
        '.[$t].flavors[$v].ghostty // (if .[$t].flavors[$v].polarity == "light" then "Builtin Light" else "Builtin Dark" end)' \
        "$SCHEMES"
    )
    echo "theme = $gfallback"
    echo "background = #$(f '.crust')"
    echo "foreground = #$fg"
    echo "cursor-color = #$accent"
    echo "cursor-text = #$(f '.crust')"
    echo "selection-background = #$(f '.crust')"
    echo "selection-foreground = #$(f '.crust')"
    # Ghostty requires the explicit `N=#hex` index form (verified with
    # `ghostty +validate-config`); a bare `palette = #hex` is rejected.
    jq -r '.ansi | to_entries[] | "palette = \(.key)=#\(.value)"' <<<"$RJSON"
  } > "$CFG/ghostty-theme.conf"

  # --- tmux --------------------------------------------------------------
  # Colors are exposed as runtime tmux variables (@thm_*) that the static
  # Catppuccin-style status bar in modules/config/tmux references lazily
  # (#{@thm_*}), so ./theme recolors the bar with no plugin rebake.
  local rd gn yw bu ma sa sk la
  rd=$(jq -r '.named.red' <<<"$RJSON")
  gn=$(jq -r '.named.green' <<<"$RJSON")
  yw=$(jq -r '.named.yellow' <<<"$RJSON")
  bu=$(jq -r '.named.blue' <<<"$RJSON")
  ma=$(jq -r '.named.maroon' <<<"$RJSON")
  sa=$(jq -r '.named.sapphire' <<<"$RJSON")
  sk=$(jq -r '.named.sky' <<<"$RJSON")
  la=$(jq -r '.named.lavender' <<<"$RJSON")
  cr=$(f '.crust')
  cat > "$CFG/tmux-theme.conf" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
# Base styles (panes, messages, selection)
set -g status-style "bg=#$(f '.base')"
set -g pane-border-style "fg=#$(f '.overlay0')"
set -g pane-active-border-style "fg=#$accent"
set -g message-style "bg=#$(f '.surface0'),fg=#$fg"
set -g message-command-style "bg=#$accent,fg=#$(f '.base')"
set -g mode-style "bg=#$(f '.surface0'),fg=#$fg"
set -g clock-mode-colour "#$bu"
set -g display-panes-colour "#$accent"
set -g display-panes-active-colour "#$fg"
# Catppuccin-style palette variables (mirror catppuccin/tmux @thm_* naming)
set -gq @thm_bg "#$(f '.base')"
set -gq @thm_fg "#$fg"
set -gq @thm_crust "#$cr"
set -gq @thm_mantle "#$(f '.mantle')"
set -gq @thm_surface_0 "#$(f '.surface0')"
set -gq @thm_surface_1 "#$(f '.surface1')"
set -gq @thm_surface_2 "#$(f '.surface2')"
set -gq @thm_overlay_0 "#$(f '.overlay0')"
set -gq @thm_overlay_1 "#$(f '.overlay1')"
set -gq @thm_overlay_2 "#$(f '.overlay2')"
set -gq @thm_subtext_0 "#$(f '.subtext0')"
set -gq @thm_subtext_1 "#$(f '.subtext1')"
set -gq @thm_accent "#$accent"
set -gq @thm_mauve "#$accent"
set -gq @thm_red "#$rd"
set -gq @thm_green "#$gn"
set -gq @thm_yellow "#$yw"
set -gq @thm_blue "#$bu"
set -gq @thm_maroon "#$ma"
set -gq @thm_sapphire "#$sa"
set -gq @thm_sky "#$sk"
set -gq @thm_lavender "#$la"
EOF

  # --- hyprland (lua fragment dofiled on hyprctl reload) -------------------
  # active_border is a secondary -> primary gradient (flipped relative to the
  # rest of the theme, for the border only); the border-angle daemon
  # (hypr border-angle.sh) rotates it toward the cursor at runtime.
  cat > "$CFG/hyprland-theme.lua" <<EOF
-- Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
return {
  active_border = { c1 = "0x$(f '.secondary')", c2 = "0x$accent", angle = 0 },
  inactive_border = "0x$(f '.base')",
}
EOF

  # --- neovim (base16 palette applied by lua/theme.lua) ----------------------
  # Rewritten on every switch; `apply` then sends SIGUSR1 so running editors
  # re-read it. Slot order matches themes.nix `toBase16` and default.nix's
  # nvimBase16: the base0[0-9A-F] block first, then the named roles, which
  # base16 ignores and lua/theme.lua uses for layered backgrounds.
  {
    echo "-- Generated by scripts/theme ($(f '.title') / $(f '.accentName'))"
    echo "-- Read by nvim's lua/theme.lua; SIGUSR1 makes running instances reload."
    echo "return {"
    jq -r '
      def slot($i): if $i < 10 then "base0" + ($i | tostring)
                     else "base0" + ("ABCDEF"[$i - 10:$i - 9]) end;
      [
        .base, .surface0, .surface1, .overlay0, .subtext0, .text,
        .base16.rosewater, .base16.lavender, .base16.red, .base16.peach,
        .base16.yellow, .base16.green, .base16.teal, .accent,
        .base16.mauve, .base16.flamingo
      ]
      | to_entries[]
      | "  " + slot(.key) + " = \"#" + .value + "\","
    ' <<<"$RJSON"
    jq -r '
      [
        .crust, .mantle, .base, .surface0, .surface1, .surface2,
        .overlay0, .overlay1, .overlay2, .subtext0, .subtext1, .text, .accent,
        .named.blue, .base16.mauve
      ]
      | to_entries[]
      | "  " + ["crust", "mantle", "base", "surface0", "surface1", "surface2",
               "overlay0", "overlay1", "overlay2", "subtext0", "subtext1",
               "text", "accent", "blue", "mauve"][.key] + " = \"#" + .value + "\","
    ' <<<"$RJSON"
    echo "}"
  } > "$CFG/nvim-base16.lua"

  # --- p10k (powerlevel10k dir background uses the accent's ANSI slot) -----
  # Maps the accent to the nearest terminal palette slot (0-15) and writes a
  # runtime file that the declarative ~/.config/zsh/.p10k.zsh sources before
  # `p10k reload`, overriding POWERLEVEL9K_DIR_BACKGROUND.
  local p10k_dir_bg
  p10k_dir_bg=$(NEAREST=$(jq -r '.accent' <<<"$RJSON"); python3 - "$RJSON" "$NEAREST" <<'PY'
import json, sys
rj   = json.loads(sys.argv[1])
acch = sys.argv[2].lstrip('#')
r2, g2, b2 = (int(acch[i:i+2], 16) for i in (0, 2, 4))
best, bestd = 0, 3 * 256 ** 2
for i, c in enumerate(rj['ansi']):
    r, g, b = (int(c[j:j+2], 16) for j in (0, 2, 4))
    d = (r-r2)**2 + (g-g2)**2 + (b-b2)**2
    if d < bestd:
        best, bestd = i, d
sys.stdout.write(str(best))
PY
)
  cat > "$CFG/p10k-theme.zsh" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
# Overrides POWERLEVEL9K_DIR_BACKGROUND in the p10k config with the ANSI
# palette slot (0-15) nearest to the accent.
POWERLEVEL9K_DIR_BACKGROUND=$p10k_dir_bg
EOF

  # --- fzf (popup colours) ---------------------------------------------------
  # fzf paints itself in the terminal, so no Neovim highlight group can reach
  # it, and `catppuccin.fzf` bakes the flavour in at build time -- it cannot
  # follow a theme switch. The runtime file below is sourced by every new zsh
  # and uses the same three steps as the rest of the UI: surface0 for the popup
  # body, surface1 for the selected row, surface2 for the border. FZF_DEFAULT_OPTS
  # is word-split, so the colour list has to stay on one line.
  local fzf_colors="bg:#$(f '.surface0'),bg+:#$(f '.surface1')"
  fzf_colors+=",fg:#$(f '.text'),fg+:#$(f '.text')"
  fzf_colors+=",hl:#$(f '.accent'),hl+:#$(f '.accent')"
  fzf_colors+=",header:#$(f '.surface2'),border:#$(f '.surface2')"
  fzf_colors+=",info:#$(f '.subtext0'),label:#$(f '.subtext0'),query:#$(f '.text')"
  fzf_colors+=",prompt:#$(f '.accent'),pointer:#$(f '.accent')"
  fzf_colors+=",marker:#$(f '.accent'),spinner:#$(f '.accent')"
  cat > "$CFG/fzf-theme.zsh" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName'))
# Sourced by ~/.config/zsh/.zshrc.custom at shell start.
export FZF_DEFAULT_OPTS="--color ${fzf_colors}"
EOF
}

# Build the Noctalia palette JSON for the resolved roles + accent.
# qutebrowser has no env-var theming and its config.py execs this file, so
# rewrite it wholesale. The variable set matches the M3 names noctalia/matugen
# emits (the file was frozen on Catppuccin Macchiato values).
gen_qutebrowser_colors() {
  local dir="${XDG_CONFIG_HOME:-$HOME/.config}/qutebrowser/noctalia"
  mkdir -p "$dir"
  local b16='.base16'
  local qred qmaroon; qred=$(f "$b16.red"); qmaroon=$(f "$b16.maroon")
  cat > "$dir/colors.py" <<EOF
# Generated by scripts/theme ($(f '.title') / $(f '.accentName')) — do not edit.
# qutebrowser config.py exec()s this file, so the bare assignments below become
# qutebrowser's color.* names.
surface = "#$(f '.crust')"
surface_dim = "#$(f '.mantle')"
surface_bright = "#$(f '.surface2')"
surface_container = "#$(f '.surface0')"
surface_container_low = "#$(f '.mantle')"
surface_container_lowest = "#$(f '.crust')"
surface_container_high = "#$(f '.surface1')"
surface_container_highest = "#$(f '.surface2')"
surface_variant = "#$(f '.surface0')"
on_surface = "#$(f '.text')"
on_surface_variant = "#$(f '.subtext1')"
inverse_surface = "#$(f '.text')"
inverse_on_surface = "#$(f '.base')"
primary = "#$(f '.accent')"
on_primary = "#$(f '.crust')"
primary_container = "#$(f '.surface1')"
on_primary_container = "#$(f '.text')"
inverse_primary = "#$(f '.mantle')"
secondary = "#$(f '.secondary')"
on_secondary = "#$(f '.crust')"
secondary_container = "#$(f '.surface1')"
on_secondary_container = "#$(f '.text')"
tertiary = "#$(f '.tertiary')"
on_tertiary = "#$(f '.crust')"
tertiary_container = "#$(f '.surface1')"
on_tertiary_container = "#$(f '.text')"
outline = "#$(f '.overlay1')"
outline_variant = "#$(f '.overlay0')"
error = "#$qred"
on_error = "#$(f '.crust')"
error_container = "#$qmaroon"
on_error_container = "#$(f '.text')"
EOF
}

gen_noctalia_palette() {
  mkdir -p "$PALETTES_DIR"
  jq -c --arg pol "$(f '.polarity')" '
    {
      ($pol): {
        mPrimary: "#"+.accent,
        mSecondary: "#"+.secondary,
        mTertiary: "#"+.tertiary,
        mSurface: "#"+.base,
        mSurfaceVariant: "#"+.surface0,
        mOnSurface: "#"+.text,
        mOnSurfaceVariant: "#"+.subtext0,
        mOnPrimary: "#"+.base,
        mOnSecondary: "#"+.mantle,
        mOnTertiary: "#"+.mantle,
        mOutline: "#"+.overlay0,
        mError: "#"+(.ansi[1]|tostring),
        mHover: "#"+.hover,
        mOnError: "#"+.base,
        mOnHover: "#"+.base,
        mShadow: "#"+.crust,
        terminal: {
          background: "#"+.crust,
          foreground: "#"+.text,
          cursor: "#"+.text,
          cursorText: "#"+.base,
          selectionBg: "#"+.surface1,
          selectionFg: "#"+.text,
          normal: {
            black:   "#"+(.ansi[0]|tostring),
            red:     "#"+(.ansi[1]|tostring),
            green:   "#"+(.ansi[2]|tostring),
            yellow:  "#"+(.ansi[3]|tostring),
            blue:    "#"+(.ansi[4]|tostring),
            magenta: "#"+.accent,
            cyan:    "#"+(.ansi[6]|tostring),
            white:   "#"+(.ansi[7]|tostring)
          },
          bright: {
            black:   "#"+(.ansi[8]|tostring),
            red:     "#"+(.ansi[9]|tostring),
            green:   "#"+(.ansi[10]|tostring),
            yellow:  "#"+(.ansi[11]|tostring),
            blue:    "#"+(.ansi[12]|tostring),
            magenta: "#"+(.ansi[13]|tostring),
            cyan:    "#"+(.ansi[14]|tostring),
            white:   "#"+(.ansi[15]|tostring)
          }
        }
      }
    }' <<<"$RJSON" > "$PALETTE_JSON"
}

# ---------------------------------------------------------------------------
# mutagen — derive a Material You palette from the wallpaper Noctalia has
# currently applied, then push it through the exact same runtime writers as
# `theme set`. Nothing here is committed to the DB or src/selection, so a
# wallpaper-derived scheme never shows up in the Stylix rebuild; use it as a
# live-only accent. `theme set <db theme>` restores a tracked selection.
# ---------------------------------------------------------------------------
MUTAGEN_CACHE="$HOME/.cache/theme-switcher/mutagen.json"

# Current wallpaper, per Noctalia's own IPC (the authoritative answer; the
# HM-managed config.toml deliberately carries no wallpaper section).
current_wallpaper() {
  require noctalia
  noctalia msg wallpaper-get 2>/dev/null | head -1
}

# Noctalia's current light/dark mode, so mutagen follows the desktop rather
# than forcing a polarity.
current_polarity() {
  local m
  m=$(noctalia msg theme-mode-get 2>/dev/null | tr -d '[:space:]')
  case "$m" in
    light | dark) printf '%s' "$m" ;;
    *) printf 'dark' ;;
  esac
}

# Ask Noctalia to extract an M3 palette from the wallpaper. Cached per image so
# repeated switches over the same wallpaper are instant.
gen_m3_palette() {
  local wallpaper="$1" scheme="${2:-m3-tonal-spot}" mtime key out
  mtime=$(stat -c %Y "$wallpaper" 2>/dev/null || echo 0)
  key=$(printf '%s' "$wallpaper" | cksum | cut -d' ' -f1)
  out="$MUTAGEN_CACHE/${key}-${mtime}-${scheme}.json"
  [[ -s "$out" ]] && { printf '%s' "$out"; return 0; }
  mkdir -p "$MUTAGEN_CACHE"
  if ! noctalia theme "$wallpaper" --scheme "$scheme" --both -o "$out" 2>/dev/null; then
    # Older Noctalia builds may not know --both; fall back to the single-polarity
    # form and let the caller pick whichever key is present.
    if ! noctalia theme "$wallpaper" --scheme "$scheme" -o "$out" 2>/dev/null; then
      echo "error: 'noctalia theme' could not generate a palette from $wallpaper" >&2
      return 1
    fi
  fi
  [[ -s "$out" ]] || { echo "error: Noctalia produced an empty palette" >&2; return 1; }
  printf '%s' "$out"
}

# Translate Noctalia's M3 token map into the normalized roles the runtime
# writers expect. M3 already ships a full surface-container ramp and a complete
# 16-slot terminal palette, so these roles come straight from the tokens rather
# than from the Catppuccin-ratio generator used for the static DB.
m3_to_roles() { # $1 = m3 json, $2 = polarity (dark|light) -> normalized JSON
  python3 - "$1" "$2" <<'PY'
import json, re, sys

m3 = json.load(open(sys.argv[1]))
pol = sys.argv[2]

# Prefer the requested polarity, then whichever one the file actually carries.
tok = m3.get(pol) or m3.get("dark") or m3.get("light")
if tok is None:
    sys.exit("mutagen: no usable token map in " + sys.argv[1])


def h(c):
    c = str(c).lstrip("#")
    return tuple(int(c[i:i + 2], 16) for i in (0, 2, 4))


def s(rgb):
    return "%02x%02x%02x" % tuple(max(0, min(255, round(v))) for v in rgb)


def mix(a, b, t):
    return tuple(a[i] + (b[i] - a[i]) * t for i in range(3))


def n(key, *fallbacks):
    """First present token among key + fallbacks, as lowercase hex."""
    for k in (key,) + fallbacks:
        v = tok.get(k)
        if v:
            return str(v).lstrip("#").lower()
    return "000000"


# M3 ships a full surface-container ramp, so the roles map straight across.
crust = h(n("surface_container_lowest", "surface"))
mantle = h(n("surface_container_low", "surface"))
base = h(n("surface"))
sf0 = h(n("surface_container", "surface_variant"))
sf1 = h(n("surface_container_high", "surface_bright"))
sf2 = h(n("surface_container_highest"))
text = h(n("on_surface"))
ov0 = h(n("outline_variant", "outline"))
ov1 = h(n("outline"))

# M3 has no tokens for overlay2/subtext1; interpolate toward the foreground so
# they land between outline and on-surface like the static DB flavors do.
ov2 = mix(ov1, text, 0.5)
sub0 = h(n("on_surface_variant", "outline"))
sub1 = mix(sub0, text, 0.6)

primary = n("primary")
secondary = n("secondary")
tertiary = n("tertiary")
error = n("error")

# Complete 16-slot terminal palette; fall back to M3 roles per channel so a
# minimal token set still yields a usable palette.
ansi = [
    n("terminal_normal_black"),
    n("terminal_normal_red", "error"),
    n("terminal_normal_green", "terminal_bright_green"),
    n("terminal_normal_yellow", "terminal_bright_yellow"),
    n("terminal_normal_blue", "primary"),
    n("terminal_normal_magenta", "tertiary"),
    n("terminal_normal_cyan", "terminal_bright_cyan"),
    n("terminal_normal_white", "terminal_bright_white"),
    n("terminal_bright_black"),
    n("terminal_bright_red", "error"),
    n("terminal_bright_green", "terminal_normal_green"),
    n("terminal_bright_yellow", "terminal_normal_yellow"),
    n("terminal_bright_blue", "primary"),
    n("terminal_bright_magenta", "tertiary"),
    n("terminal_bright_cyan", "terminal_normal_cyan"),
    n("terminal_bright_white", "on_surface"),
]
if not all(re.fullmatch(r"[0-9a-f]{6}", c) for c in ansi):
    sys.exit("mutagen: token set is missing terminal palette slots")

# M3 only defines primary/secondary/tertiary/error, so Noctalia's terminal slots
# are often degenerate: all eight chromatic hues can collapse onto four colors
# (blue+magenta = primary, green+magenta = tertiary, ...). Distinctness is the
# whole point of an ANSI palette -- grep, diffs and build output all depend on
# red/green/yellow being tellable apart -- so synthesize the chromatic slots by
# rotating the accent hues when the extracted set is too degenerate to use.
CHROMA = [1, 2, 3, 4, 5, 6, 9, 10, 11, 12, 13, 14]
if len({ansi[i] for i in CHROMA}) < 6:
    import colorsys

    # Hue anchors chosen to line up with the conventional ANSI order, then
    # seeded from the wallpaper's own accent so the result still reads as
    # derived from the image rather than as a canned palette.
    hues = [0.00, 0.33, 0.13, 0.58, 0.83, 0.50, 0.00, 0.33, 0.13, 0.58, 0.83, 0.50]
    srcs = [error, ansi[10], ansi[11], primary, tertiary, secondary,
            error, ansi[10], ansi[11], primary, tertiary, secondary]
    bright = {9: 1.00, 10: 1.00, 11: 1.00, 12: 1.00, 13: 1.00, 14: 1.00}
    for slot, hue, src in zip(CHROMA, hues, srcs):
        r, g, b = (v / 255.0 for v in h(src))
        hh, ll, ss = colorsys.rgb_to_hls(r, g, b)
        # Keep the accent's own saturation but lift lightness on the bright set.
        if slot in bright:
            ll = min(0.85, max(0.55, ll + 0.12))
            ss = max(ss, 0.35)
        ansi[slot] = s(tuple(c * 255 for c in colorsys.hls_to_rgb(hue, ll, ss)))

roles = {
    "theme": "mutagen",
    "variant": pol,
    "accentName": "primary",
    "accent": primary,
    "polarity": pol,
    "title": "Mutagen " + pol.capitalize(),
    "base": s(base),
    "mantle": s(mantle),
    "crust": s(crust),
    "surface0": s(sf0),
    "surface1": s(sf1),
    "surface2": s(sf2),
    "overlay0": s(ov0),
    "overlay1": s(ov1),
    "overlay2": s(ov2),
    "subtext0": s(sub0),
    "subtext1": s(sub1),
    "text": s(text),
    "ansi": ansi,
    "named": {
        "mauve": tertiary,
        "red": error,
        "maroon": ansi[9],
        "green": ansi[10],
        "yellow": ansi[11],
        "blue": primary,
        "sapphire": ansi[12],
        "sky": secondary,
        "lavender": ansi[15],
        "teal": secondary,
    },
    "base16": {
        "rosewater": s(text),
        "lavender": s(text),
        "red": error,
        "peach": tertiary,
        "orange": tertiary,
        "yellow": ansi[11],
        "green": ansi[10],
        "teal": secondary,
        "cyan": ansi[14],
        "mauve": tertiary,
        "purple": tertiary,
        "flamingo": error,
    },
    "secondary": secondary,
    "tertiary": tertiary,
    "hover": ansi[10],
}
print(json.dumps(roles, separators=(",", ":")))
PY
}

# Apply runtime changes across the stack.
apply() {
  local label="$1" polarity="$2"
  # Icons + platform colour scheme follow the polarity (Papirus themes).
  if command -v gsettings >/dev/null 2>&1; then
    if [[ "$polarity" == "light" ]]; then
      gsettings set org.gnome.desktop.interface color-scheme prefer-light
      gsettings set org.gnome.desktop.interface icon-theme Papirus-Light
    else
      gsettings set org.gnome.desktop.interface color-scheme prefer-dark
      gsettings set org.gnome.desktop.interface icon-theme Papirus-Dark
    fi
  fi
  # Terminals
  if command -v tmux >/dev/null 2>&1 && tmux ls >/dev/null 2>&1; then
    tmux source-file "$CFG/tmux-theme.conf" >/dev/null 2>&1 || true
    # Repaint the whole status line so the right segment re-renders cleanly
    # (source-file alone can leave stale background/style on part of the bar).
    tmux refresh-client -S >/dev/null 2>&1 || true
  fi
  if command -v kitty >/dev/null 2>&1; then
    pkill -USR1 kitty >/dev/null 2>&1 || true
  fi
  if command -v ghostty >/dev/null 2>&1; then
    ghostty +reload-config >/dev/null 2>&1 || true
  fi
  if command -v nvim >/dev/null 2>&1; then
    pkill -USR1 nvim >/dev/null 2>&1 || true
  fi
  # Noctalia + Hyprland
  if command -v noctalia >/dev/null 2>&1; then
    noctalia msg config-reload >/dev/null 2>&1 || true
    noctalia msg templates-apply >/dev/null 2>&1 || true
  fi
  hyprctl reload >/dev/null 2>&1 || true
  # Hermes Agent skin + the non-terminal apps that only accept a file path
  # (herdr, superfile, rofi, hyprlock) follow the active theme-switcher palette.
  gen_hermes_skin
  gen_herdr_theme_block
  gen_herdr_theme
  gen_superfile_theme
  gen_rofi_colors
  gen_hyprlock_theme
  gen_qutebrowser_colors
  # wezterm auto-reloads via its watch list when the theme file changes.
  notify-send "Theme" "Switched to $label" >/dev/null 2>&1 || true
}

# Persist the selection into the tracked repo file so build-time consumers
# (Stylix on the home + system side, the catppuccin module) follow it.
write_selection() {
  mkdir -p "$(dirname "$SELECTION")"
  local accentName
  accentName=$(f '.accentName')
  # The home-manager catppuccin module accepts a fixed accent list that lacks
  # "cyan"; map DB-only names to their hex-identical module-valid neighbor so
  # build-time (Stylix/catppuccin) colors stay consistent with the runtime.
  case "$accentName" in
    cyan) accentName="sky" ;;
  esac
  printf '%s %s %s\n' "$(f '.theme')" "$(f '.variant')" "$accentName" > "$SELECTION"
}

# Rebuild home-manager so Stylix (GTK/KDE/Qt/..) picks up the new selection.
rebuild_stylix() {
  local label="$1"
  echo "Rebuilding home-manager so Stylix (GTK/KDE/Qt/..) follows..."
  if ( cd "$REPO_ROOT" && home-manager switch --flake .#"${CONFIG_VAR_USERNAME:-zeph}" ); then
    # Persist the selection in git so future clean builds stay consistent.
    ( cd "$REPO_ROOT" \
      && git add modules/home/config/themes/colors/src/selection \
      && git commit -m "Theme: $label" --quiet ) || true
    echo "✓ Stylix updated to '$label'"
  else
    echo "error: home-manager rebuild failed (Stylix not updated)" >&2
    return 1
  fi
}

cmd_set() {
  check_sel "$@"
  local polarity
  polarity=$(f '.polarity')
  gen_noctalia_palette
  write_runtime_files
  mkdir -p "$(dirname "$STATE")"
  printf '%s %s %s\n' "$(f '.theme')" "$(f '.variant')" "$(f '.accentName')" > "$STATE"
  write_selection
  local label="$(f '.title') ($(f '.accentName'))"
  echo "theme: $label"
  if [[ "${RUNTIME_ONLY:-0}" == "0" ]]; then
    rebuild_stylix "$label" || return 1
    if [[ "${SYSTEM_SWITCH:-0}" == "1" ]]; then
      echo "Switching NixOS system (console/plymouth follow)..."
      ( cd "$REPO_ROOT" \
        && nh os switch --elevation-strategy pkexec .#nixosConfigurations."${CONFIG_VAR_HOSTNAME:-Lingnao}" ) \
        || { echo "error: system switch failed" >&2; return 1; }
    fi
  else
    echo "(skipping rebuild: --runtime)"
  fi
  apply "$label" "$polarity"
}

# Derive a palette from the wallpaper Noctalia has currently applied and push it
# through the same runtime writers as `theme set`. Always runtime-only: the
# result is wallpaper-derived, so it is never written to src/selection and never
# survives a rebuild. `theme set <db theme>` restores a tracked selection.
cmd_mutagen() {
  local scheme="$MUTAGEN_SCHEME" polarity wallpaper m3
  wallpaper=$(current_wallpaper || true)
  if [[ -z "$wallpaper" ]]; then
    echo "error: could not read the current wallpaper from Noctalia" >&2
    echo "       (is noctalia running? try 'noctalia msg wallpaper-get')" >&2
    return 1
  fi
  if [[ ! -f "$wallpaper" ]]; then
    echo "error: Noctalia reports wallpaper '$wallpaper', which does not exist" >&2
    return 1
  fi
  polarity=$(current_polarity)
  m3=$(gen_m3_palette "$wallpaper" "$scheme" || true)
  if [[ -z "$m3" ]]; then
    return 1
  fi
  RJSON=$(m3_to_roles "$m3" "$polarity")
  if [[ -z "$RJSON" ]] || ! jq -e . >/dev/null <<<"$RJSON"; then
    echo "error: could not map the Noctalia palette onto theme roles" >&2
    return 1
  fi
  gen_noctalia_palette
  write_runtime_files
  mkdir -p "$(dirname "$STATE")"
  printf 'mutagen %s primary\n' "$polarity" > "$STATE"
  local label="Mutagen $(tr '[:lower:]' '[:upper:]' <<<"$polarity") (primary)"
  echo "wallpaper: $wallpaper"
  echo "theme: $label"
  echo "(mutagen is runtime-only: not tracked in src/selection, no rebuild)"
  apply "$label" "$polarity"
}

cmd_list() {
  for t in $(themes_list); do
    echo "Theme: $t"
    for v in $(variants_of "$t"); do
      printf '  %-12s (%s) accents: %s\n' "$v" "$(jq -r --arg t "$t" --arg v "$v" '.[$t].flavors[$v].polarity' "$SCHEMES")" "$(accents_of "$t" "$v" | paste -sd' ')"
    done
  done
}

cmd_current() {
  if [[ -f "$STATE" ]]; then
    echo "current: $(cat "$STATE")"
  else
    echo "current: <unset> — using build-time default (Catppuccin macchiato mauve)"
  fi
}

cmd_hermes() {
  # Generate/update the Hermes Agent skin from the current theme-switcher state.
  if [[ ! -f "$STATE" ]]; then
    echo "error: no theme-switcher state at $STATE (run 'theme <theme> <variant> <accent>' first)" >&2
    exit 1
  fi
  read -r theme variant accent <<<"$(cat "$STATE")"
  check_sel "$theme" "$variant" "$accent" || exit 1
  gen_hermes_skin
  echo "hermes: skin generated for $(f '.title') / $(f '.accentName')"
}

usage() {
  echo "usage:"
  echo "  $0 <theme> <variant> [accent] [--runtime] [--system]"
  echo "  $0 set <theme> <variant> [accent] [--runtime] [--system]"
  echo "  $0 mutagen           Derive a Material You palette from the current wallpaper"
  echo "  $0 list"
  echo "  $0 current"
  echo "  $0 hermes            Regenerate the Hermes Agent skin from the current theme"
  echo
  echo "  --runtime  hot-swap everything that reads a file (skip the Stylix rebuild)"
  echo "  --system   also switch the NixOS system (console/plymouth; polkit)"
  echo "  --scheme <name>  mutagen generator scheme (default: m3-tonal-spot)"
}

cmd="${1:-}"

# Position-independent flags; everything else is treated as the theme selection.
RUNTIME_ONLY=0
SYSTEM_SWITCH=0
MUTAGEN_SCHEME="m3-tonal-spot"
SEL_ARGS=()
for ((i = 1; i <= $#; i++)); do
  case "${!i}" in
    --runtime) RUNTIME_ONLY=1 ;;
    --system) SYSTEM_SWITCH=1 ;;
    --scheme)
      ((i++))
      MUTAGEN_SCHEME="${!i:-m3-tonal-spot}"
      ;;
    set | mutagen) : ;; # subcommand keywords
    *) SEL_ARGS+=("${!i}") ;;
  esac
done

if [[ "$cmd" == "set" ]]; then
  cmd_set "${SEL_ARGS[0]:?theme required}" "${SEL_ARGS[1]:?variant required}" "${SEL_ARGS[2]:-}"
  exit 0
fi
if [[ "$cmd" == "mutagen" ]]; then
  cmd_mutagen
  exit 0
fi
handled=0
case "$cmd" in
  list | -l) cmd_list; handled=1 ;;
  current | status) cmd_current; handled=1 ;;
  hermes) cmd_hermes; handled=1 ;;
  help | -h | --help)
    usage
    handled=1
    ;;
esac
if [[ "$handled" -eq 1 ]]; then
  exit 0
fi
if [[ ${#SEL_ARGS[@]} -gt 0 ]]; then
  cmd_set "${SEL_ARGS[0]}" "${SEL_ARGS[1]:?variant required}" "${SEL_ARGS[2]:-}"
else
  usage >&2
  exit 1
fi
