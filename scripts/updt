#!/usr/bin/env bash
#
# updt — unified NixOS & home-manager update script.
#
# Every option runs the same pipeline: banner -> steps -> git sync (for the
# flake-touching options) -> success/failure notification. Options 1-4 always
# end with an automatic commit + push so the repo never drifts; option 6 is
# the manual push for pre-existing commits; option 5 (flatpak) doesn't touch
# the flake.

set -euo pipefail

# --- Configuration ----------------------------------------------------------
# Values default to the var module's (see modules/shared/var.nix); the
# `updt`/`theme` wrappers installed by home-manager export the real ones.
FLAKE_PATH="${CONFIG_VAR_CONFIG_DIRECTORY:-$HOME/.config/nixos}"
NIXOS_HOST="${CONFIG_VAR_HOSTNAME:-Lingnao}"
HOME_USER="${CONFIG_VAR_USERNAME:-zeph}"
SUCCESS_SOUND="/run/current-system/sw/share/sounds/freedesktop/stereo/complete.oga"
ERROR_SOUND="/run/current-system/sw/share/sounds/freedesktop/stereo/dialog-error.oga"

# --- Colors ------------------------------------------------------------------
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

# --- Output helpers -----------------------------------------------------------
banner() { echo -e "\n${BOLD}${BLUE}═══ $1 ═══${NC}"; }
info()   { echo -e "${BLUE}ℹ${NC} $1"; }
ok()     { echo -e "${GREEN}✅${NC} $1"; }
warn()   { echo -e "${YELLOW}⚠${NC} $1"; }
err()    { echo -e "${RED}❌${NC} $1"; }

notify() {
    local title="$1" message="$2" urgency="${3:-normal}"
    # notify-send needs a session bus, so stay quiet when run from a timer.
    if [[ -z "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ]]; then
        return 0
    fi
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" "$title" "$message" >/dev/null 2>&1 || true
    fi
}

play_sound() {
    local sound="$1"
    if [[ -f "$sound" ]] && command -v pw-play >/dev/null 2>&1; then
        pw-play "$sound" >/dev/null 2>&1 || true
    fi
}

notify_success() {
    ok "$1 finished successfully"
    notify "✅ $1" "Finished successfully."
    play_sound "$SUCCESS_SOUND"
}

notify_failure() {
    err "$1 failed"
    notify "❌ $1" "Check the terminal for details." critical
    play_sound "$ERROR_SOUND"
}

# --- Pre-flight ----------------------------------------------------------------
check_directory() {
    if ! cd "$FLAKE_PATH" 2>/dev/null; then
        err "Flake directory not found: $FLAKE_PATH"
        exit 1
    fi
}

check_git_status() {
    if [[ -z "$(git status --porcelain 2>/dev/null)" ]]; then
        return 0
    fi

    warn "Uncommitted changes detected:"
    git status --short
    echo

    if [[ -t 0 ]] && command -v lazygit >/dev/null 2>&1; then
        info "Opening LazyGit to review changes..."
        sleep 2
        lazygit || true
    else
        read -rp "Press Enter to continue or Ctrl+C to abort... " || true
    fi
}

auth_pkexec() {
    # Authenticate via polkit (GUI dialog from the KDE agent). Auth is then
    # cached, so no sudo terminal prompt appears during the switch.
    info "Requesting root access via pkexec..."
    if pkexec "$(command -v true)" >/dev/null 2>&1; then
        return 0
    fi
    err "Authentication via pkexec failed"
    return 1
}

# --- Individual steps (each returns 0/1) -----------------------------------------
update_flake() {
    info "Updating flake inputs..."
    if nix flake update; then
        ok "Flake inputs updated"
        return 0
    fi
    err "Flake update failed"
    return 1
}

build_system() {
    info "Building NixOS system ($NIXOS_HOST)..."
    if nh os build .#nixosConfigurations."$NIXOS_HOST"; then
        ok "NixOS build succeeded"
        return 0
    fi
    err "NixOS build failed"
    return 1
}

switch_system() {
    info "Switching NixOS system ($NIXOS_HOST)..."
    # nh escalates internally; pkexec provides the cached GUI auth from above.
    if nh os switch --elevation-strategy pkexec .#nixosConfigurations."$NIXOS_HOST"; then
        ok "NixOS switch succeeded"
        return 0
    fi
    err "NixOS switch failed"
    return 1
}

build_home() {
    info "Building home-manager configuration ($HOME_USER)..."
    if home-manager build --flake .#"$HOME_USER"; then
        ok "Home-manager build succeeded"
        return 0
    fi
    err "Home-manager build failed"
    return 1
}

switch_home() {
    info "Switching home-manager configuration ($HOME_USER)..."
    if home-manager switch --flake .#"$HOME_USER"; then
        ok "Home-manager switch succeeded"
        if command -v kbuildsycoca6 >/dev/null 2>&1; then
            kbuildsycoca6 --noincremental || warn "Failed to refresh KDE application cache"
        fi
        return 0
    fi
    err "Home-manager switch failed"
    return 1
}

update_flatpak() {
    info "Updating flatpak applications and runtimes..."
    if ! command -v flatpak >/dev/null 2>&1; then
        warn "flatpak is not installed"
        return 1
    fi
    if flatpak update -y; then
        ok "Flatpak applications updated"
        return 0
    fi
    err "Flatpak update failed"
    return 1
}

stage_all() {
    # nh/home-manager evaluate the flake from the git tree; untracked files are
    # invisible to it and break builds. Stage everything (incl. deletions and
    # the auto-synced nvim lazy-lock.json) so builds see the working tree.
    # Deliberately NOT -f: force-adding would re-stage git-ignored files such
    # as result/, AGENTS.md and secrets/* into commits.
    info "Staging working tree for flake evaluation..."
    if git add -A -- .; then
        ok "Working tree staged"
        return 0
    fi
    err "git add failed"
    return 1
}

gc() {
    info "Collecting old generations (system + user)..."
    if ! pkexec nix-collect-garbage -d >/dev/null 2>&1; then
        sudo -n nix-collect-garbage -d >/dev/null 2>&1 || warn "System gc skipped (needs root)"
    fi
    nix-collect-garbage -d >/dev/null 2>&1 || warn "User gc skipped"
    info "Optimising the store..."
    nix-store --optimise >/dev/null 2>&1 || warn "Store optimise skipped"
    ok "Garbage collected"
}

cb() {
    info "Rebuilding the boot menu from the current system..."
    if ! pkexec /run/current-system/bin/switch-to-configuration boot >/dev/null 2>&1; then
        sudo -n /run/current-system/bin/switch-to-configuration boot >/dev/null 2>&1 || {
            err "Boot menu rebuild failed"
            return 1
        }
    fi
    ok "Boot menu rebuilt"
}

listgen() {
    info "System generations:"
    if ! pkexec nix-env -p /nix/var/nix/profiles/system --list-generations; then
        sudo -n nix-env -p /nix/var/nix/profiles/system --list-generations || {
            err "Could not list generations"
            return 1
        }
    fi
}

# --- Chromium extensions -------------------------------------------------------
# Extensions live as unpacked directories loaded via --load-extension (see
# pkgs/chromium-extensions). Chromium cannot update unpacked extensions itself,
# so upstream pins in $EXT_PINS are bumped here instead.
EXT_PINS="pkgs/chromium-extensions/src/extensions.json"
# Unauthenticated GitHub API calls are capped at 60/h; a token raises that.
GITHUB_TOKEN_FILE="$FLAKE_PATH/.github_token"
EXT_QUERY_ERRORS=0

ext_is_newer() {
    [[ "$1" != "$2" ]] && [[ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1)" == "$2" ]]
}

ext_latest_tag() {
    local owner="$1" repo="$2" source="$3"
    if [[ "$source" == "tag-tarball" ]]; then
        git ls-remote --tags --refs --sort=-v:refname "https://github.com/$owner/$repo" 2>/dev/null |
            awk 'NR == 1 { sub(/^refs\/tags\//, "", $2); print $2 }'
        return
    fi

    local -a headers=(-H "Accept: application/vnd.github+json")
    local token="${GITHUB_TOKEN:-}"
    if [[ -z "$token" && -r "$GITHUB_TOKEN_FILE" ]]; then
        token="$(<"$GITHUB_TOKEN_FILE")"
    fi
    [[ -n "$token" ]] && headers+=(-H "Authorization: Bearer $token")

    local body code
    body="$(mktemp)"
    code="$(curl -sSL -o "$body" -w '%{http_code}' "${headers[@]}" \
        "https://api.github.com/repos/$owner/$repo/releases/latest" || echo 000)"
    if [[ "$code" != "200" ]]; then
        if [[ "$code" == "403" || "$code" == "429" ]]; then
            err "GitHub API rate limit hit — export GITHUB_TOKEN or add $GITHUB_TOKEN_FILE"
        else
            err "GitHub API returned HTTP $code for $owner/$repo"
        fi
        rm -f "$body"
        return 1
    fi
    jq -r '.tag_name // empty' "$body"
    rm -f "$body"
}

ext_asset_url() {
    local owner="$1" repo="$2" source="$3" tag="$4" asset="$5"
    if [[ "$source" == "tag-tarball" ]]; then
        printf 'https://github.com/%s/%s/archive/refs/tags/%s.tar.gz' "$owner" "$repo" "$tag"
    else
        printf 'https://github.com/%s/%s/releases/download/%s/%s' "$owner" "$repo" "$tag" "$asset"
    fi
}

# Writes "name<TAB>pinned<TAB>tag<TAB>version<TAB>url" per outdated extension.
# The tab-separated reader collapses empty fields (tab is IFS whitespace), so
# jq substitutes a sentinel for the optional asset name.
ext_scan() {
    local out="$1"
    : >"$out"
    EXT_QUERY_ERRORS=0
    local name owner repo source pinned_tag asset pinned latest latest_version url
    while IFS=$'\t' read -r name owner repo source pinned_tag asset pinned; do
        [[ "$asset" == "__NULL__" ]] && asset=""
        if ! latest="$(ext_latest_tag "$owner" "$repo" "$source")" || [[ -z "$latest" ]]; then
            warn "Could not query upstream for $name ($owner/$repo)"
            EXT_QUERY_ERRORS=$((EXT_QUERY_ERRORS + 1))
            continue
        fi
        latest_version="${latest#v}"
        ext_is_newer "$pinned" "$latest_version" || continue
        asset="${asset//\{version\}/$latest_version}"
        asset="${asset//\{tag\}/$latest}"
        url="$(ext_asset_url "$owner" "$repo" "$source" "$latest" "$asset")"
        printf '%s\t%s\t%s\t%s\t%s\n' "$name" "$pinned" "$latest" "$latest_version" "$url" >>"$out"
    done < <(jq -r 'to_entries[] |
        [.key, .value.owner, .value.repo, .value.source, .value.tag,
         (.value.asset // "__NULL__"), .value.version] | @tsv' "$EXT_PINS")
}

ext_report() {
    local scan="$1"
    local count
    count="$(grep -c . "$scan" || true)"
    if [[ "$count" -eq 0 ]]; then
        ok "Chromium extensions are up to date"
        return 1
    fi
    warn "$count Chromium extension update(s) available:"
    local name pinned tag version url
    while IFS=$'\t' read -r name pinned tag version url; do
        echo -e "    ${BOLD}$name${NC}: $pinned -> ${GREEN}$version${NC}"
    done <"$scan"
    return 0
}

ext_check() {
    if [[ ! -f "$EXT_PINS" ]]; then
        err "Missing $EXT_PINS"
        return 1
    fi
    info "Checking Chromium extension updates..."
    local scan
    scan="$(mktemp)"
    ext_scan "$scan"
    local status=0
    if [[ "$EXT_QUERY_ERRORS" -gt 0 ]]; then
        err "$EXT_QUERY_ERRORS extension(s) could not be checked — results are incomplete"
        status=1
    fi
    if ext_report "$scan"; then
        notify "Chromium extensions" "Updates available — run: updt ext --apply"
    fi
    rm -f "$scan"
    return "$status"
}

ext_apply() {
    if [[ ! -f "$EXT_PINS" ]]; then
        err "Missing $EXT_PINS"
        return 1
    fi
    local scan
    scan="$(mktemp)"
    ext_scan "$scan"
    if [[ "$EXT_QUERY_ERRORS" -gt 0 ]]; then
        err "Refusing to bump pins with $EXT_QUERY_ERRORS upstream lookup(s) failing"
        rm -f "$scan"
        return 1
    fi
    ext_report "$scan" || {
        rm -f "$scan"
        return 0
    }
    info "Bumping pins and prefetching hashes..."
    local name pinned tag version url hash
    while IFS=$'\t' read -r name pinned tag version url; do
        hash="$(nix store prefetch-file --json "$url" 2>/dev/null | jq -r '.hash // empty')"
        if [[ -z "$hash" ]]; then
            err "Could not prefetch $url"
            rm -f "$scan"
            return 1
        fi
        jq --arg name "$name" --arg tag "$tag" --arg version "$version" \
           --arg url "$url" --arg hash "$hash" \
           '.[$name] |= (.tag = $tag | .version = $version | .url = $url | .hash = $hash)' \
           "$EXT_PINS" >"$EXT_PINS.tmp"
        mv "$EXT_PINS.tmp" "$EXT_PINS"
        ok "$name: $pinned -> $version"
    done <"$scan"
    rm -f "$scan"
    return 0
}

commit_and_push() {
    if [[ -z "$(git status --porcelain 2>/dev/null)" ]]; then
        info "No changes to commit"
        return 0
    fi

    info "Committing changes..."
    git add -A
    local stamp files
    stamp="Update: $(date '+%Y-%m-%d %H:%M:%S')"
    files="$(git diff --cached --name-only | wc -l | tr -d ' ')"
    if ! git commit -m "$stamp ($files files changed)"; then
        err "Commit failed"
        return 1
    fi
    ok "Committed: $stamp ($files files changed)"

    push_only
}

push_only() {
    info "Pushing to remote..."
    if git push; then
        ok "Pushed to remote"
        return 0
    fi
    err "Push failed"
    return 1
}

# --- Workflow ------------------------------------------------------------------
# run_workflow NAME SYNC_GIT [STEP...]
# Runs every step in order; the first failure aborts the option. If SYNC_GIT is
# true, changes are committed and pushed once all steps pass, then the same
# success/failure notification fires for every option.
run_workflow() {
    local name="$1" sync_git="$2"
    shift 2

    banner "$name"

    local step
    for step in "$@"; do
        if ! "$step"; then
            notify_failure "$name"
            return 1
        fi
    done

    if [[ "$sync_git" == true ]] && ! commit_and_push; then
        notify_failure "$name"
        return 1
    fi

    notify_success "$name"
}

# --- Menu -----------------------------------------------------------------------
execute_option() {
    case "$1" in
        1) run_workflow "Update All"           true  auth_pkexec update_flake stage_all build_system switch_system build_home switch_home ;;
        2) run_workflow "Update Flake Only"    true  update_flake ;;
        3) run_workflow "Update System Only"   true  auth_pkexec stage_all build_system switch_system ;;
        4) run_workflow "Update Home Only"     true  stage_all build_home switch_home ;;
        5) run_workflow "Update Flatpak"       false update_flatpak ;;
        6) run_workflow "Git Push"             false push_only ;;
        7) exit 0 ;;
        *) err "Invalid option: $1" ; return 1 ;;
    esac
}

usage_sub() {
    echo "usage: $0 [subcommand]"
    echo
    echo "  (no args)          interactive menu"
    echo "  all / update       flake + system + home (commit + push)"
    echo "  flake              flake inputs only (commit + push)"
    echo "  system             NixOS build + switch (commit + push)"
    echo "  home               home-manager build + switch (commit + push)"
    echo "  flatpak            update flatpak applications"
    echo "  push               push committed changes"
    echo "  gc                 collect garbage + optimise the store"
    echo "  cb / boot          rebuild the boot menu"
    echo "  listgen            list NixOS generations"
    echo "  ext                check Chromium extension updates (--apply bumps + rebuilds)"
    echo "  help               show this help"
}

subcommand() {
    case "$1" in
        all | update)      execute_option 1 ;;
        flake)             execute_option 2 ;;
        system | sys)      execute_option 3 ;;
        home)              execute_option 4 ;;
        flatpak)           execute_option 5 ;;
        push)              execute_option 6 ;;
        gc)                run_workflow "Garbage Collect"       false gc ;;
        cb | boot)         run_workflow "Rebuild Boot Menu"     false cb ;;
        listgen)           run_workflow "List Generations"      false listgen ;;
        ext)
            case "${2:-}" in
                --apply | apply) run_workflow "Extension Update"     false auth_pkexec ext_apply stage_all build_system switch_system ;;
                *)             run_workflow "Extension Update Check" false ext_check ;;
            esac
            ;;
        help | -h | --help) usage_sub ;;
        *) err "Unknown subcommand: $1"; usage_sub >&2; return 1 ;;
    esac
}

parse_choices() {
    local input="$1"
    local -a choices=()
    local part
    local IFS=','

    for part in $input; do
        part="${part//[[:space:]]/}"
        [[ -z "$part" ]] && continue

        if [[ "$part" =~ ^([0-9]+)-([0-9]+)$ ]]; then
            local start="${BASH_REMATCH[1]}" end="${BASH_REMATCH[2]}"
            if ((start <= end)); then
                for ((i = start; i <= end; i++)); do
                    choices+=("$i")
                done
            else
                warn "Ignoring invalid range: $part"
            fi
        elif [[ "$part" =~ ^[0-9]+$ ]]; then
            choices+=("$part")
        else
            warn "Ignoring invalid option: $part"
        fi
    done

    printf '%s\n' "${choices[@]}"
}

main() {
    check_directory

    # Subcommand mode (updt gc, updt home, ...) bypasses the interactive menu.
    if [[ $# -gt 0 ]]; then
        subcommand "$@"
        return $?
    fi

    check_git_status

    clear || true

    echo -e "${BOLD}${BLUE}🚀 NixOS Update Script${NC}"
    echo -e "${BLUE}========================${NC}"
    echo
    echo -e "${BOLD}Options${NC} (comma-separated or ranges, e.g. 3,4 or 2-4):"
    echo -e "  1. ${GREEN}Update All${NC}        — flake + system + home-manager (commit + push)"
    echo -e "  2. ${YELLOW}Update Flake Only${NC} — flake inputs only (commit + push)"
    echo -e "  3. ${RED}Update System Only${NC} — NixOS build + switch (commit + push)"
    echo -e "  4. ${BLUE}Update Home Only${NC}  — home-manager build + switch (commit + push)"
    echo -e "  5. ${YELLOW}Update Flatpak${NC}    — flatpak applications"
    echo -e "  6. ${GREEN}Git Push${NC}         — push committed changes"
    echo -e "  7. ${RED}Exit${NC}"
    echo
    echo -e "${BOLD}Subcommands${NC}: updt gc | cb | listgen | push | ext | all | help"
    echo

    read -rp "Enter choice(s) (1-7): " input

    local -a choices=()
    mapfile -t choices < <(parse_choices "$input")
    if [[ ${#choices[@]} -eq 0 ]]; then
        err "No valid options selected"
        exit 1
    fi

    # Deduplicate while preserving order
    local -A seen=()
    local -a todo=()
    local c
    for c in "${choices[@]}"; do
        [[ -n "${seen[$c]:-}" ]] && continue
        seen[$c]=1
        todo+=("$c")
    done

    info "Executing options: ${todo[*]}"
    echo

    for c in "${todo[@]}"; do
        if ! execute_option "$c"; then
            err "Option $c failed"
            exit 1
        fi
    done

    echo
    ok "All selected options completed"
}

main "$@"