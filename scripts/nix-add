#!/usr/bin/env bash
# Fuzzy search nixpkgs and append to home or system
# Usage: nix-add [--home|--system|--sys] [query]

set -euo pipefail

FLAKE_DIR="${FLAKE_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/nixos}"
PKG_DIR="$FLAKE_DIR/pkgs"
USER_FILE="$PKG_DIR/user-packages.nix"
SYS_FILE="$PKG_DIR/system-packages.nix"

# Parse args
TARGET=""
QUERY=""
HAS_TARGET=0
ARGS=()
for arg in "$@"; do
  case "$arg" in
    --home) TARGET="home"; HAS_TARGET=1 ;;
    --system|--sys) TARGET="system"; HAS_TARGET=1 ;;
    *) ARGS+=("$arg") ;;
  esac
done
if ((${#ARGS[@]} > 0)); then
  QUERY="${ARGS[*]}"
fi

# Ensure required tools
for cmd in fzf nix-search-tv nixfmt git; do
  command -v "$cmd" >/dev/null 2>&1 || { echo "Missing: $cmd" >&2; exit 1; }
done

# Step 1: Target selection (only if no target flag was given)
if [ "$HAS_TARGET" -eq 0 ]; then
  TARGET=$(echo -e "home\nsystem" | fzf --prompt="target> " --height=20% --border --no-multi --reverse)
  if [ -z "$TARGET" ]; then
    exit 0
  fi
  if [ "$TARGET" = "home" ]; then
    FILE="$USER_FILE"
    NAME="home"
  else
    FILE="$SYS_FILE"
    NAME="system"
  fi
else
  if [ "$TARGET" = "home" ]; then
    FILE="$USER_FILE"
    NAME="home"
  else
    FILE="$SYS_FILE"
    NAME="system"
  fi
fi

# Step 2: Package list
TMPFILE=$(mktemp)
trap 'rm -f "$TMPFILE"' EXIT

if command -v nix-search-tv >/dev/null 2>&1; then
  if [ -n "$QUERY" ]; then
    nix-search-tv print 2>/dev/null | grep '^nixpkgs/' | sed 's/^nixpkgs\///' | fzf --query="$QUERY" --height=40% --reverse --border --prompt="nixpkgs> " --no-multi > "$TMPFILE"
  else
    nix-search-tv print 2>/dev/null | grep '^nixpkgs/' | sed 's/^nixpkgs\///' | fzf --height=40% --reverse --border --prompt="nixpkgs> " --no-multi > "$TMPFILE"
  fi
  [ -s "$TMPFILE" ] || { rm -f "$TMPFILE"; exit 0; }
fi
SELECTED=$(<"$TMPFILE")

# Check if already present
if grep -qE "^[[:space:]]*${SELECTED//./\\.}[[:space:]]*$" "$FILE" 2>/dev/null || grep -qE "^\s*${SELECTED//./\.}\b" "$FILE"; then
  echo "Package '$SELECTED' already in $NAME packages." >&2
  exit 0
fi

# Append before the final closing ]
TMPFILE2=$(mktemp)
trap 'rm -f "$TMPFILE" "$TMPFILE2"' EXIT

python3 - "$FILE" "$SELECTED" << 'PY'
import sys

path = sys.argv[1]
pkg = sys.argv[2]

with open(path) as f:
    content = f.read()

lines = content.rstrip().splitlines()
for i in range(len(lines)-1, -1, -1):
    stripped = lines[i].strip()
    if stripped == ']':
        indent = len(lines[i]) - len(lines[i].lstrip())
        insert_indent = ' ' * (indent if indent >= 4 else 4)
        lines.insert(i, insert_indent + pkg)
        break
else:
    lines.append('    ' + pkg)
    lines.append('  ]')

new_content = '\n'.join(lines)
if not new_content.endswith('\n'):
    new_content += '\n'

with open(path, 'w') as f:
    f.write(new_content)
PY

echo "Added '$SELECTED' to $FILE"

if command -v nixfmt >/dev/null 2>&1; then
  nixfmt "$FILE" 2>/dev/null || true
fi

echo "Done. Rebuild with: $( [ "$TARGET" = "home" ] && echo 'home-manager switch --flake .#zeph' || echo 'nh os switch .#nixosConfigurations.Lingnao' )"
